---
import Base from './Base.astro';
import EntryCard from '../components/EntryCard.astro';
import {
  SITE, COLLECTION_LABELS, COLLECTION_BLURBS,
  HERO, HUB, UI, type Locale,
} from '../config';
import { getEntries, localePath, countLabel } from '../lib/content';

interface Props { lang: Locale }
const { lang } = Astro.props;
const other: Locale = lang === 'en' ? 'tr' : 'en';
const hero = HERO[lang];

const [essays, notes, playbooks, signals] = await Promise.all([
  getEntries('essays', lang),
  getEntries('notes', lang),
  getEntries('playbooks', lang),
  getEntries('signals', lang),
]);

// Essays'te öne çıkarılanlar başa.
const featured = [...essays].sort(
  (a, b) => Number((b.data as any).featured) - Number((a.data as any).featured)
);

const more = lang === 'tr' ? 'Devamı' : 'Learn more';
---

<Base title={`${SITE.author} — ${hero.role}`} description={hero.rest.trim()} lang={lang}
      altLocale={{ lang: other, href: localePath(other, '') }}>

  <section class="wrap hero">
    <h1><strong>{hero.name}</strong>{hero.rest}</h1>
    <p class="sub">
      <span>{hero.role}</span>
      <span>{hero.now}</span>
    </p>
  </section>

  <section class="wrap hub">
    <h2>{HUB.name[lang]}</h2>
    <p class="hub-blurb">
      {HUB.blurb[lang]}{' '}
      <a href={localePath(lang, 'topics')}>{more} <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <div class="wrap columns">
    {/* Sol kolon: kartlar */}
    <div class="col-main">
      {featured.length > 0 && (
        <section class="block">
          <h3 class="section-title">
            <a href={localePath(lang, 'essays')}>{COLLECTION_LABELS.essays[lang]} <span aria-hidden="true">→</span></a>
          </h3>
          <p class="blurb">{COLLECTION_BLURBS.essays[lang]}</p>
          <div class="cards">
            {featured.slice(0, 4).map((entry) => (
              <EntryCard collection="essays" entry={entry} lang={lang} variant="card" />
            ))}
          </div>
        </section>
      )}

      {playbooks.length > 0 && (
        <section class="block">
          <h3 class="section-title">
            <a href={localePath(lang, 'playbooks')}>{COLLECTION_LABELS.playbooks[lang]} <span aria-hidden="true">→</span></a>
          </h3>
          <p class="blurb">{COLLECTION_BLURBS.playbooks[lang]}</p>
          <div class="cards">
            {playbooks.slice(0, 4).map((entry) => (
              <EntryCard collection="playbooks" entry={entry} lang={lang} variant="card" />
            ))}
          </div>
        </section>
      )}
    </div>

    {/* Sağ kolon: listeler */}
    <aside class="col-side">
      {notes.length > 0 && (
        <section class="block">
          <h3 class="section-title">
            <a href={localePath(lang, 'notes')}>{COLLECTION_LABELS.notes[lang]} <span aria-hidden="true">→</span></a>
          </h3>
          <p class="blurb">{COLLECTION_BLURBS.notes[lang]}</p>
          <ul class="rows">
            {notes.slice(0, 8).map((entry) => (
              <li><EntryCard collection="notes" entry={entry} lang={lang} variant="row" /></li>
            ))}
          </ul>
        </section>
      )}

      {signals.length > 0 && (
        <section class="block">
          <h3 class="section-title">
            <a href={localePath(lang, 'signals')}>{COLLECTION_LABELS.signals[lang]} <span aria-hidden="true">→</span></a>
          </h3>
          <p class="blurb">{COLLECTION_BLURBS.signals[lang]}</p>
          <ul class="rows">
            {signals.slice(0, 8).map((entry) => (
              <li><EntryCard collection="signals" entry={entry} lang={lang} variant="row" /></li>
            ))}
          </ul>
        </section>
      )}

      <p class="count meta">
        {countLabel(essays.length + notes.length + playbooks.length + signals.length, lang)}
        {' · '}
        <a href={localePath(lang, 'topics')}>{UI[lang].allTopics}</a>
      </p>
    </aside>
  </div>
</Base>

<style>
  /* — Hero — */
  .hero { padding-block: var(--s-l) var(--s-2xl); }
  h1 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    font-size: var(--t-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    max-inline-size: 30ch;
    text-wrap: pretty;
  }
  h1 strong { font-weight: 700; }

  .sub {
    display: grid;
    gap: .15em;
    margin-block-start: var(--s-m);
    font-family: var(--f-sans);
    font-size: var(--t-md);
    line-height: 1.35;
    color: var(--c-muted);
  }

  /* — Şemsiye bölüm — */
  .hub { padding-block-end: var(--s-xl); }
  .hub h2 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    font-size: var(--t-xl);
    line-height: var(--lh-snug);
  }
  .hub-blurb {
    margin-block-start: var(--s-2xs);
    max-inline-size: 62ch;
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .hub-blurb a { color: var(--c-accent); text-decoration: none; white-space: nowrap; }

  /* — İki kolon: Maggie'nin asimetrik ızgarası — */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    gap: var(--s-xl);
    align-items: start;
  }

  .col-main .block + .block { margin-block-start: var(--s-2xl); }
  .col-side .block + .block { margin-block-start: var(--s-l); }
  .blurb {
    margin-block-start: var(--s-3xs);
    max-inline-size: 46ch;
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--c-muted);
  }

  .cards {
    margin-block-start: var(--s-s);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-xs);
  }

  .rows { list-style: none; padding: 0; margin-block-start: var(--s-2xs); }
  .rows > li { padding-block: var(--s-2xs); }
  .rows > li + li { border-block-start: 1px solid var(--c-border); }

  .count { margin-block-start: var(--s-l); }
  .count a { color: var(--c-accent); text-decoration: none; }

  @media (max-width: 56rem) {
    .columns { grid-template-columns: 1fr; gap: var(--s-2xl); }
    h1 { max-inline-size: none; }
  }
</style>
