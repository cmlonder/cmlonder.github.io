---
/** Domain tek sayfa — yazılmış bölümler art arda, solda omurga (#b çapaları). */
import { render } from 'astro:content';
import Base from './Base.astro';
import Spine from '../components/Spine.astro';
import { DOMAINS, DOMAIN_UI, type Locale } from '../config';
import { localePath } from '../lib/content';

interface Props { lang: Locale; dm: any; bolumler: { slug: string; no: number; entry: any }[]; toplam: number }
const { lang, dm, bolumler, toplam } = Astro.props;
const dSlug = dm.id.split('/').pop()!;
const t = DOMAIN_UI[lang];
const yazilan = new Map(bolumler.map((b) => [b.slug, b.entry]));
const render_ = await Promise.all(bolumler.map(async (b) => ({ ...b, C: (await render(b.entry)).Content })));
---

<Base title={`${dm.data.title} — ${t.onePage}`} description={dm.data.thesis} lang={lang}
      ai={bolumler.some((b) => b.entry.data.ai === 'generated') ? 'generated' : undefined}>
  <div class="reading" data-reader data-scroll="up">
    <aside class="toc-col">
      <Spine title={dm.data.title} outline={dm.data.outline} yazilan={yazilan} domain={dSlug} lang={lang} hash />
    </aside>

    <article class="narrow">
      <header class="head">
        <p class="kicker"><a href={localePath(lang, DOMAINS.path, dSlug)}>{DOMAINS.name[lang]}</a></p>
        <h1>{dm.data.title}</h1>
        <p class="thesis">{dm.data.thesis}</p>
        <p class="n">{bolumler.length}/{toplam} {t.written}</p>
      </header>

      <Spine title={dm.data.title} outline={dm.data.outline} yazilan={yazilan} domain={dSlug} lang={lang} hash variant="mobile" />

      {render_.map((b) => (
        <section class="ch" id={`b${b.no}`}>
          <p class="chno">{t.chapter} {b.no}</p>
          <h2>{b.entry.data.title}</h2>
          <div class="prose"><b.C /></div>
        </section>
      ))}
    </article>
  </div>
</Base>

<script>
  import '../scripts/reader';
  import '../scripts/explainers/boot';
</script>

<style>
  .head { margin-block-end: var(--s-2xl); }
  .kicker { font-family: var(--f-sans); font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted); }
  .kicker a { color: var(--c-accent); text-decoration: none; }
  h1 { font-family: var(--f-serif); font-variation-settings: var(--axis-display); font-weight: 400; line-height: var(--lh-tight); margin-block-start: var(--s-2xs); }
  .thesis { margin-block-start: var(--s-s); font-family: var(--f-serif); font-size: var(--t-md); line-height: 1.35; text-wrap: balance; }
  .head .n { margin-block-start: var(--s-s); font-family: var(--f-sans); font-size: var(--t-xs); color: var(--c-muted); }
  .ch { margin-block-start: var(--s-4xl); scroll-margin-block-start: var(--s-l); }
  .ch:first-of-type { margin-block-start: 0; }
  .chno { font-family: var(--f-mono); font-size: var(--t-xs); color: var(--c-muted); letter-spacing: .06em; }
  .ch h2 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-xl); line-height: var(--lh-snug);
    margin-block: var(--s-2xs) var(--s-m); padding-block-end: var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
</style>
