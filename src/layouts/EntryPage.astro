---
import { render } from 'astro:content';
import Base from './Base.astro';
import {
  COLLECTION_LABELS, TOPIC_LABELS, STATUS_LABELS,
  type CollectionName, type Locale,
} from '../config';
import EntryCard from '../components/EntryCard.astro';
import Comments from '../components/Comments.astro';
import { formatDate, localePath, entryPath, getTranslations, parseId, getRelated, getNeighbours } from '../lib/content';
import type { AnyEntry } from '../lib/content';

interface Props {
  collection: CollectionName;
  entry: AnyEntry;
  lang: Locale;
}

const { collection, entry, lang } = Astro.props;
const { slug } = parseId(entry.id);
const d = entry.data as any;

const { Content } = await render(entry);

// Diğer dilde karşılığı var mı?
const langs = await getTranslations(collection, slug);
const other = langs.find((l) => l !== lang) ?? null;
const altLocale = other
  ? { lang: other, href: localePath(other, collection, slug) }
  : null;

const entryHref = (e: AnyEntry) => entryPath(lang, collection, parseId(e.id).slug);

const related = await getRelated(collection, entry, lang);
const { newer, older } = await getNeighbours(collection, entry, lang);

const t = {
  updated: lang === 'tr' ? 'Güncellendi' : 'Updated',
  problem: lang === 'tr' ? 'Problem' : 'Problem',
  context: lang === 'tr' ? 'Bağlam' : 'Context',
  via:     lang === 'tr' ? 'Kaynak'  : 'Source',
  related: lang === 'tr' ? 'İlgili'   : 'Related',
  newer:   lang === 'tr' ? 'Daha yeni': 'Newer',
  older:   lang === 'tr' ? 'Daha eski': 'Older',
};
---

<Base title={`${d.title} — ${COLLECTION_LABELS[collection][lang]}`}
      description={d.description} lang={lang} altLocale={altLocale}
      structured={{ collection, entry }}>
  <article class="narrow">
    <header class="entry-head">
      <p class="meta kicker">
        <a href={localePath(lang, collection)}>{COLLECTION_LABELS[collection][lang]}</a>
        <span aria-hidden="true">·</span>
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {collection === 'notes' && (
          <><span aria-hidden="true">·</span><span>{STATUS_LABELS[d.status as keyof typeof STATUS_LABELS][lang]}</span></>
        )}
        {d.updatedDate && (
          <><span aria-hidden="true">·</span><span>{t.updated} {formatDate(d.updatedDate, lang)}</span></>
        )}
      </p>

      <h1>{d.title}</h1>
      <p class="standfirst">{d.description}</p>

      {collection === 'playbooks' && (
        <dl class="facts">
          <dt class="meta">{t.problem}</dt><dd>{d.problem}</dd>
          <dt class="meta">{t.context}</dt><dd>{d.context}</dd>
        </dl>
      )}

      {collection === 'signals' && (
        <p class="signal-source">
          <span class="meta">{t.via}</span>
          <a href={d.url} rel="noopener">{d.source}</a>
        </p>
      )}
    </header>

    <div class="prose"><Content /></div>

    <footer class="entry-foot">
      <p class="topics meta">
        {d.topics.map((topic: keyof typeof TOPIC_LABELS) => (
          <a href={localePath(lang, 'topics', topic)}>{TOPIC_LABELS[topic][lang]}</a>
        ))}
      </p>

      {(newer || older) && (
        <nav class="neighbours" aria-label={COLLECTION_LABELS[collection][lang]}>
          {older ? (
            <a class="prev" href={entryHref(older)}>
              <span class="meta">&#8592; {t.older}</span>
              <span class="ttl">{(older.data as any).title}</span>
            </a>
          ) : <span />}
          {newer && (
            <a class="next" href={entryHref(newer)}>
              <span class="meta">{t.newer} &#8594;</span>
              <span class="ttl">{(newer.data as any).title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>

  {related.length > 0 && (
    <aside class="narrow related">
      <h2 class="section-title">{t.related}</h2>
      <ul>
        {related.map((r) => (
          <li>
            <EntryCard collection={r.collection} entry={r.entry} lang={lang}
                       variant="row" showCollection />
          </li>
        ))}
      </ul>
    </aside>
  )}

  {d.commentable && <Comments lang={lang} />}
</Base>

<script>
  // Açıklayıcılar yalnızca yazı sayfalarında olabilir; kayıt tablosu
  // sayfada ilgili etiket yoksa hiçbir modül indirmez.
  import './../scripts/explainers/boot';
</script>

<style>
  .entry-head { margin-block-end: var(--s-l); }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-block-end: var(--s-xs);
  }
  .kicker a {
    text-decoration: none;
    color: var(--c-accent);
    font-weight: 700;
  }

  h1 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-2xl);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    text-wrap: balance;
    max-inline-size: 20ch;
  }

  .standfirst {
    margin-block-start: var(--s-xs);
    max-inline-size: var(--w-prose);
    color: var(--c-muted);
    font-size: 1.0625rem;
    font-style: italic;
    text-wrap: pretty;
  }

  .facts {
    margin-block-start: var(--s-s);
    max-inline-size: var(--w-prose);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3xs) var(--s-xs);
    padding-block: var(--s-xs);
    border-block: 1px solid var(--c-border);
    font-size: 1rem;
  }
  .facts dt { text-transform: uppercase; letter-spacing: 0.08em; padding-block-start: 0.25em; }

  .signal-source {
    margin-block-start: var(--s-s);
    display: flex;
    align-items: baseline;
    gap: var(--s-2xs);
    font-size: 1rem;
  }
  .signal-source .meta { text-transform: uppercase; letter-spacing: 0.08em; }
  .signal-source a { color: var(--c-accent); text-decoration-color: var(--c-accent); }

  .entry-foot a { text-decoration-color: var(--c-border); }

  .entry-foot {
    margin-block-start: var(--s-xl);
    padding-block-start: var(--s-s);
    border-block-start: 1px solid var(--c-border);
  }
  .topics { display: flex; flex-wrap: wrap; gap: var(--s-2xs); }

  .neighbours {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-s);
    margin-block-start: var(--s-m);
  }
  .neighbours a { display: grid; gap: 2px; text-decoration: none; }
  .neighbours .next { text-align: end; }
  .neighbours .ttl {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-sm);
    line-height: var(--lh-snug);
  }
  .neighbours a:hover .ttl { color: var(--c-accent); }

  .related { margin-block-start: var(--s-2xl); }
  .related ul {
    list-style: none; padding: 0; margin-block-start: var(--s-s);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-m) var(--s-l);
    align-items: start;
  }
</style>
