---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE, ANALYTICS, type CollectionName, type Locale } from '../config';
import { localePath } from '../lib/content';
import type { AnyEntry } from '../lib/content';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Bu sayfanın diğer dildeki karşılığı (varsa). */
  altLocale?: { lang: Locale; href: string } | null;
  /** Yazı sayfalarında JSON-LD'ye Article ekler. */
  structured?: { collection: CollectionName; entry: AnyEntry } | undefined;
  /** Paylaşım görseli. Verilmezse koleksiyona göre, o da yoksa varsayılan. */
  ogImage?: string;
  /** AI kökeni — görünmez meta etiketi (ai-disclosure önerisi). */
  ai?: 'generated' | 'assisted';
}

const { title, description, lang, altLocale = null, structured, ogImage, ai } = Astro.props;

// Paylaşım görseli: sayfa > koleksiyon > varsayılan
const ogCandidates = ['essays', 'notes', 'playbooks', 'signals', 'library'];
const fromPath = ogCandidates.find((c) => Astro.url.pathname.includes(`/${c}`));
const ogPath = ogImage ?? `/og/${structured?.collection ?? fromPath ?? 'default'}.png`;
const ogUrl = new URL(ogPath, SITE.url).href;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const home = localePath(lang, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altLocale && (
      <link rel="alternate" hreflang={altLocale.lang} href={new URL(altLocale.href, SITE.url).href} />
    )}

    <meta property="og:type" content={structured ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {ai && <meta name="ai-disclosure" content={ai === 'generated' ? 'ai-generated' : 'ai-assisted'} />}
    {/* Makine okurları için: yazının ham Markdown aynası. İnsana görünmez. */}
    {structured && (
      <link rel="alternate" type="text/markdown" href={new URL(Astro.url.pathname.replace(/\/$/, '') + '.md', SITE.url).href} />
    )}
    <link rel="alternate" type="application/rss+xml"
          title={`${SITE.author} — RSS`} href={localePath(lang, 'rss.xml')} />
    <StructuredData lang={lang} entry={structured} />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    {/*
      GA4. Script'ler is:inline olmak zorunda: Astro normal <script>
      etiketlerini koşuldan bağımsız paketliyor ve kapalıyken sayfaya ölü
      kod düşüyor — giscus'ta aynı tuzağa düşülmüştü.
      import.meta.env.PROD: dev sunucusundaki gezinti mülke yazılmasın.
      define:vars kullanılmıyor: Astro script'i IIFE'ye sarıyor ve gtag
      global olmuyor. Sayfa görüntüleme yine gidiyor (dataLayer global)
      ama ileride olay göndermek isteyen kod gtag'i bulamıyor.
    */}
    {ANALYTICS.enabled && import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', '${ANALYTICS.ga4}');
        `} />
      </>
    )}

    {/* Tema, boyamadan önce uygulanmalı — aksi halde beyaz flaş olur. */}
    <script is:inline>
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{lang === 'tr' ? 'İçeriğe geç' : 'Skip to content'}</a>

    <SiteHeader lang={lang} altLocale={altLocale} />

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <style>
      .skip {
        position: absolute;
        inset-block-start: -100%;
        inset-inline-start: var(--s-xs);
        z-index: 30;
        background: var(--c-surface);
        border: 1px solid var(--c-border);
        padding: var(--s-3xs) var(--s-2xs);
        border-radius: var(--radius);
        font-family: var(--f-sans);
        font-size: var(--t-sm);
      }
      .skip:focus { inset-block-start: var(--s-xs); }

      main { padding-block: var(--s-l) var(--s-3xl); }

    </style>
  </body>
</html>

<script>
  import '../scripts/prose-extras';
</script>
