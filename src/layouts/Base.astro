---
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE, type CollectionName, type Locale } from '../config';
import { localePath } from '../lib/content';
import type { AnyEntry } from '../lib/content';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Bu sayfanın diğer dildeki karşılığı (varsa). */
  altLocale?: { lang: Locale; href: string } | null;
  /** Yazı sayfalarında JSON-LD'ye Article ekler. */
  structured?: { collection: CollectionName; entry: AnyEntry } | undefined;
}

const { title, description, lang, altLocale = null, structured } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const home = localePath(lang, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altLocale && (
      <link rel="alternate" hreflang={altLocale.lang} href={new URL(altLocale.href, SITE.url).href} />
    )}

    <link rel="alternate" type="application/rss+xml"
          title={`${SITE.author} — RSS`} href={localePath(lang, 'rss.xml')} />
    <StructuredData lang={lang} entry={structured} />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    {/* Tema, boyamadan önce uygulanmalı — aksi halde beyaz flaş olur. */}
    <script is:inline>
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{lang === 'tr' ? 'İçeriğe geç' : 'Skip to content'}</a>

    <SiteHeader lang={lang} altLocale={altLocale} />

    <main id="main">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p class="meta">© {new Date().getFullYear()} {SITE.author}</p>
    </footer>

    <style>
      .skip {
        position: absolute;
        inset-block-start: -100%;
        inset-inline-start: var(--s-xs);
        z-index: 30;
        background: var(--c-surface);
        border: 1px solid var(--c-border);
        padding: var(--s-3xs) var(--s-2xs);
        border-radius: var(--radius);
        font-family: var(--f-sans);
        font-size: var(--t-sm);
      }
      .skip:focus { inset-block-start: var(--s-xs); }

      main { padding-block: var(--s-l) var(--s-3xl); }

      .site-footer {
        padding-block: var(--s-s);
        border-block-start: 1px solid var(--c-border);
      }
    </style>
  </body>
</html>
