---
/**
 * Raf listesi — /library, /films, /games için ortak.
 *
 * Tasarım maggieappleton.com/library'den: sayaç üstte küçük ve mavi,
 * başlıkta iki bölüm yan yana — "Kitaplık | Sırada" — aktif olan metin
 * renginde, kardeş sayfa gri bir bağlantı. Sıra SABİT: bitirdiklerim hep
 * solda, sırada bekleyenler hep sağda. Aktif olanı sola almak sayfalar
 * arası geçişte kelimeleri yer değiştiriyordu. Sekme yok, gruplama yok:
 * bitirdiklerim bu sayfada, sırada bekleyenler /<raf>/queue altında
 * (Maggie'nin library / antilibrary ayrımı).
 */
import Base from './Base.astro';
import ShelfCard from '../components/ShelfCard.astro';
import LangNote from '../components/LangNote.astro';
import { SHELVES, UI, type ShelfName, type Locale } from '../config';
import { localePath } from '../lib/content';

interface Props {
  shelf: ShelfName; lang: Locale; shown?: Locale; items: any[]; altHref: string;
  /** 'done' = bitirdiklerim, 'queued' = sırada bekleyenler (antilibrary) */
  mode?: 'done' | 'queued';
}
const { shelf, lang, shown = lang, items, altHref, mode = 'done' } = Astro.props as Props;

const meta = SHELVES[shelf];
const other = lang === 'tr' ? 'en' : 'tr';
const yol = (e: any) => localePath(lang, meta.path, e.id.split('/').pop()!);

const bitmis = items.filter((e) => e.data.status !== 'queued');
const sirada = items.filter((e) => e.data.status === 'queued');
const gosterilen = mode === 'queued' ? sirada : bitmis;
const baslik = mode === 'queued' ? meta.queued[lang] : meta.name[lang];
const aciklama = mode === 'queued' ? meta.queuedBlurb[lang] : meta.blurb[lang];
const kardes = mode === 'queued'
  ? { href: localePath(lang, meta.path), label: meta.name[lang], n: bitmis.length }
  : { href: localePath(lang, meta.path, 'queue'), label: meta.queued[lang], n: sirada.length };
---

<Base title={`${baslik} — Cemal Önder`} description={aciklama}
      lang={lang} altLocale={{ lang: other as Locale, href: altHref }}>
  <div class="wrap">
    <header class="head">
      <p class="count" aria-hidden="true">{gosterilen.length}</p>
      <h1>
        {mode === 'queued'
          ? <a class="sibling" href={kardes.href}>{meta.name[lang]}</a>
          : <span class="current">{meta.name[lang]}</span>}
        {(mode === 'queued' || kardes.n > 0) && (
          <>
            <span class="sep" aria-hidden="true">|</span>
            {mode === 'queued'
              ? <span class="current">{meta.queued[lang]}</span>
              : <a class="sibling" href={kardes.href}>{meta.queued[lang]}</a>}
          </>
        )}
      </h1>
      <p class="blurb">{aciklama}</p>
    </header>

    <LangNote lang={lang} shown={shown} />

    {gosterilen.length === 0 ? <p class="meta">{UI[lang].empty}</p> : (
      <ul class="grid">
        {gosterilen.map((e) => (
          <li><ShelfCard entry={e} shelf={shelf} lang={lang} href={yol(e)} /></li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .wrap { max-inline-size: var(--w-page); margin-inline: auto; }
  .head { margin-block-end: var(--s-2xl); }

  .count {
    margin: 0;
    font-family: var(--f-serif);
    font-size: var(--t-md);
    line-height: 1;
    color: var(--c-mark-ink);
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin: var(--s-3xs) 0 var(--s-s);
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-3xl);
    font-weight: 400;
    line-height: var(--lh-tight);
    text-wrap: balance;
  }
  .current { color: var(--c-text); }
  .sep {
    margin-inline: .12em;
    font-weight: 200;
    color: var(--c-border);
  }
  .sibling {
    color: var(--c-muted);
    text-decoration: none;
    transition: color .4s ease-in-out;
  }
  .sibling:is(:hover, :focus-visible) { color: var(--c-accent-lo); }

  .blurb {
    margin: 0;
    max-inline-size: 60ch;
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-text);
    font-size: var(--t-lg);
    font-weight: 300;
    line-height: var(--lh-snug);
    color: var(--c-muted);
    text-wrap: pretty;
  }

  .grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--s-s);
  }
  .grid li { margin: 0; }

  .meta { font-family: var(--f-sans); color: var(--c-muted); }

  @media (max-width: 48rem) {
    h1 { font-size: var(--t-2xl); }
    .blurb { font-size: var(--t-md); }
  }
  @media (max-width: 34rem) {
    .head { margin-block-end: var(--s-xl); }
    .grid { grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--s-xs); }
  }
</style>
