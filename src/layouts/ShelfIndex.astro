---
/**
 * Raf listesi — /library, /films, /games için ortak.
 *
 * Maggie'nin library / antilibrary ayrımı: bitirdiklerim bu sayfada,
 * sırada bekleyenler /<raf>/queue altında. Sekme yok, gruplama yok —
 * kapak ızgarası ve üstte kardeş sayfaya tek bağlantı.
 */
import Base from './Base.astro';
import ShelfCard from '../components/ShelfCard.astro';
import LangNote from '../components/LangNote.astro';
import { SHELVES, UI, PAGE, type ShelfName, type Locale } from '../config';
import { localePath } from '../lib/content';

interface Props {
  shelf: ShelfName; lang: Locale; shown?: Locale; items: any[]; altHref: string;
  /** 'done' = bitirdiklerim, 'queued' = sırada bekleyenler (antilibrary) */
  mode?: 'done' | 'queued';
}
const { shelf, lang, shown = lang, items, altHref, mode = 'done' } = Astro.props as Props;

const meta = SHELVES[shelf];
const other = lang === 'tr' ? 'en' : 'tr';
const yol = (e: any) => localePath(lang, meta.path, e.id.split('/').pop()!);

const bitmis = items.filter((e) => e.data.status !== 'queued');
const sirada = items.filter((e) => e.data.status === 'queued');
// Maggie'nin library / antilibrary ayrımı: iki sayfa, sekme yok.
const gosterilen = mode === 'queued' ? sirada : bitmis;
const baslik = mode === 'queued' ? meta.queued[lang] : meta.name[lang];
const aciklama = mode === 'queued' ? meta.queuedBlurb[lang] : meta.blurb[lang];
const kardes = mode === 'queued'
  ? { href: localePath(lang, meta.path), label: meta.name[lang], n: bitmis.length }
  : { href: localePath(lang, meta.path, 'queue'), label: meta.queued[lang], n: sirada.length };
---

<Base title={`${baslik} — Cemal Önder`} description={aciklama}
      lang={lang} altLocale={{ lang: other as Locale, href: altHref }}>
  <div class="wrap">
    <header class="head">
      <p class="kicker">
        <span class="count">{gosterilen.length}</span>
        <a href={localePath(lang, '')}>{PAGE[lang].back}</a>
      </p>
      <h1>{baslik}</h1>
      <p class="blurb">{aciklama}</p>
      {kardes.n > 0 && (
        <p class="kardes"><a href={kardes.href}>{kardes.label} <span class="n">{kardes.n}</span> <span aria-hidden="true">&#8594;</span></a></p>
      )}
    </header>

    <LangNote lang={lang} shown={shown} />

    {gosterilen.length === 0 ? <p class="meta">{UI[lang].empty}</p> : (
      <ul class="grid">
        {gosterilen.map((e) => (
          <li><ShelfCard entry={e} shelf={shelf} lang={lang} href={yol(e)} /></li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .wrap { max-inline-size: var(--w-page); margin-inline: auto; }
  .head { margin-block-end: var(--s-2xl); max-inline-size: 60ch; }
  .kicker {
    margin-block-end: var(--s-2xs);
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark-ink); margin-inline-end: .7em; }
  .kicker a { color: var(--c-accent); text-decoration: none; }
  h1 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; line-height: var(--lh-tight);
  }
  .blurb {
    margin-block-start: var(--s-2xs);
    font-family: var(--f-serif); font-size: var(--t-md);
    color: var(--c-muted); line-height: 1.35; text-wrap: balance;
  }

  .grid {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--s-l) var(--s-m);
  }

  .kardes { margin-block-start: var(--s-s); font-family: var(--f-sans); font-size: var(--t-sm); }
  .kardes a { color: var(--c-accent); text-decoration: none; }
  .kardes .n { color: var(--c-mark-ink); font-variant-numeric: tabular-nums; }

  @media (max-width: 34rem) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: var(--s-m) var(--s-s); }
  }
</style>
