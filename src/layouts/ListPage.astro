---
import Base from './Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { HUB, UI, PAGE, type CollectionName, type Locale } from '../config';
import { localePath } from '../lib/content';
import type { AnyEntry } from '../lib/content';

interface Props {
  /** Başlığın yanında duran ek eylem (ör. playbook karar ağacı). */
  action?: { label: string; href: string } | null;
  title: string;
  blurb: string;
  lang: Locale;
  items: { collection: CollectionName; entry: AnyEntry }[];
  altLocale?: { lang: Locale; href: string } | null;
  showCollection?: boolean;
}

const { title, blurb, lang, items, altLocale = null, showCollection = false, action = null } = Astro.props;
const back = PAGE[lang].back;
// Koleksiyonlar kendi gövdesini veriyor; vermeyenler varsayılan ızgarayı alıyor.
const kendiGovdesi = Astro.slots.has('default');
---

<Base title={`${title} — Cemal Önder`} description={blurb} lang={lang} altLocale={altLocale}>
  <div class="wrap">
    <header class="head">
      <p class="kicker">
        <span class="count">{items.length}</span>
        <a href={localePath(lang, '')}>{back}</a>
      </p>
      <h1>{title}</h1>
      <p class="blurb">{blurb}</p>
      {action && <p class="action"><a href={action.href}>{action.label} <span class="arrow" aria-hidden="true">&#8594;</span></a></p>}
    </header>

    {items.length === 0 ? (
      <p class="meta empty">{UI[lang].empty}</p>
    ) : kendiGovdesi ? (
      <slot />
    ) : (
      <ul class="grid">
        {items.map(({ collection, entry }) => (
          <li>
            <EntryCard collection={collection} entry={entry} lang={lang}
                       variant="row" showCollection={showCollection} showDescription as="h2" />
          </li>
        ))}
      </ul>
    )}
  <slot name="after" />
  </div>
</Base>

<style>
  .arrow { margin-inline-start: .4em; }
  .head { margin-block-end: var(--s-2xl); }

  .kicker {
    margin-block-end: var(--s-2xs);
    display: flex;
    align-items: baseline;
    gap: var(--s-2xs);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark-ink); font-variant-numeric: tabular-nums; }
  .kicker a { text-decoration: none; }

  h1 {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    font-size: var(--t-3xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }

  .blurb {
    margin-block-start: var(--s-2xs);
    max-inline-size: 38ch;
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-lg);
    line-height: 1.25;
    color: var(--c-muted);
    text-wrap: pretty;
  }

  /* Maggie'nin 3 kolonlu liste ızgarası */
  .action {
    margin-block-start: var(--s-s);
    font-family: var(--f-sans); font-size: var(--t-sm);
  }
  .action a { color: var(--c-accent); text-decoration: none; }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s-l) var(--s-xl);
    align-items: start;
  }

  .empty { margin-block-start: var(--s-m); }
</style>
