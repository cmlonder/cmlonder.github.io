---
/**
 * İçindekiler — Maggie Appleton kalıbı: sol sütunda, yapışkan, sessiz
 * bir liste; okunan bölüm aksanla işaretli. Üstünde küçük bir "gizle".
 *
 * Geniş ekranda ızgaranın sol sütunu (EntryPage), dar ekranda yazının
 * başında açılır-kapanır bir <details>. İkisi de sunucuda basılıyor;
 * JS yalnızca gizle/göster ve okunan bölüm.
 */
import type { Locale } from '../config';
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  label: string;
  lang: Locale;
  /** 'col' = sol sütun, 'mobile' = yazı başındaki details */
  variant?: 'col' | 'mobile';
}
const { headings, label, lang, variant = 'col' } = Astro.props as Props;
const oge = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{oge.length > 1 && variant === 'col' && (
  <nav class="toc" aria-label={label}>
    <p class="toc-h">{label}</p>
    <ol>
      {oge.map((h) => (
        <li data-d={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

{oge.length > 1 && variant === 'mobile' && (
  <details class="toc-mobil">
    <summary>{label}</summary>
    <ol>
      {oge.map((h) => (
        <li data-d={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </details>
)}
