---
interface Claim {
  claim: string; url?: string; sourceDate?: string; sourceType: string;
  verdict: string; detail?: string; ageMonths?: number | null; stale?: boolean;
}
interface Props { claims: Claim[]; failedOnly?: boolean }
const { claims, failedOnly = false } = Astro.props;

// Script kaynağı okuyup aranan değeri arıyor — "doğrulama" demek fazla
// iddialı olur. Eşleşti/eşleşmedi, tam olarak yapılan şey.
const LABEL: Record<string, string> = {
  DOGRULANDI: 'Eşleşti',
  BULUNAMADI: 'Eşleşmedi',
  ERISILEMEDI: 'Kaynağa erişilemedi',
  URL_YOK: 'Kaynak yok',
  YETERSIZ: 'Sayfa okunamadı',
  ERISILDI: 'Kontrol edilmedi',
  KAYNAKSIZ: 'Kaynaksız model',
};
const BAD = ['BULUNAMADI', 'ERISILEMEDI', 'URL_YOK'];
const rows = failedOnly ? claims.filter((c) => BAD.includes(c.verdict)) : claims;
---

{rows.length > 0 && (
  <div class="scroll">
    <table>
      <thead>
        <tr><th>İddia</th><th>Kaynak</th><th>Tarih</th><th>Kaynakta</th></tr>
      </thead>
      <tbody>
        {rows.map((c) => (
          <tr class:list={[c.verdict.toLowerCase()]}>
            <td>{c.claim}</td>
            <td data-label="Kaynak">
              {c.url
                ? <a href={c.url} rel="noopener nofollow">{new URL(c.url).hostname.replace(/^www\./, '')}</a>
                : <span class="none">—</span>}
              <span class="type">{c.sourceType}</span>
            </td>
            <td class="num" data-label="Tarih">
              {c.sourceDate ? String(c.sourceDate).slice(0, 10) : '—'}
              {c.stale && <span class="stale">{c.ageMonths} ay</span>}
            </td>
            <td data-label="Kaynakta">
              <span class="verdict">{LABEL[c.verdict] ?? c.verdict}</span>
              {c.detail && c.detail !== c.sourceType && <span class="detail">{c.detail}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .scroll {
    overflow-x: auto;
    margin-block-start: var(--s-s);
    min-inline-size: 0;   /* ızgara/flex çocuğu varsayılan min-width:auto ile küçülemiyor */
  }
  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    line-height: 1.45;
  }
  th, td {
    text-align: start;
    vertical-align: top;
    padding: var(--s-3xs) var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
  th {
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 400;
    white-space: nowrap;
  }
  .num { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .type, .detail, .stale { display: block; color: var(--c-muted); }
  .stale { font-size: .9em; }
  .none { color: var(--c-muted); }
  .verdict { font-weight: 700; }

  tr.dogrulandi .verdict { color: var(--c-mark); }
  tr.bulunamadi .verdict, tr.erisilemedi .verdict, tr.url_yok .verdict { color: var(--c-accent); }
  tr.kaynaksiz .verdict, tr.yetersiz .verdict { color: var(--c-muted); }

  tr.bulunamadi, tr.erisilemedi, tr.url_yok {
    background: color-mix(in srgb, var(--c-accent) 5%, transparent);
  }

  /* Telefonda 4 kolonluk tablo 504px'e taşıyordu. Her satır bir kart:
     önce iddia, sonra sonuç, en altta kaynak künyesi. Etiketler yerine
     sıralama ve tipografi taşıyor — 4 tane KAYNAK/TARİH başlığı gürültüydü. */
  @media (max-width: 40rem) {
    .scroll { overflow-x: visible; }
    table, tbody { display: block; }
    thead { position: absolute; inline-size: 1px; block-size: 1px;
            overflow: hidden; clip-path: inset(50%); }
    tr {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: .45em;
      border: 1px solid var(--c-border);
      border-radius: var(--radius);
      padding: var(--s-xs);
      margin-block-end: var(--s-2xs);
    }
    td { display: block; border: 0; padding: 0; }

    td:first-child {                       /* iddia */
      order: 1; flex: 1 0 100%;
      font-size: var(--t-sm); line-height: 1.4;
    }
    td[data-label='Kaynakta'] {            /* sonuç + teşhis */
      order: 2; flex: 1 0 100%;
      margin-block-start: var(--s-2xs);
    }
    td[data-label='Kaynak'] { order: 3; }  /* künye, tek satırda akar */
    td[data-label='Tarih']  { order: 4; }
    td[data-label='Kaynak'], td[data-label='Tarih'] {
      margin-block-start: var(--s-2xs);
      font-size: var(--t-xs);
      color: var(--c-muted);
    }
    td[data-label='Tarih']::before { content: '·'; margin-inline-end: .45em; }
    td[data-label='Kaynak'] { flex: 0 1 auto; }
    td[data-label='Kaynak'] .type { display: block; }   /* künyenin altına */
    .num { white-space: normal; }
    .stale { display: inline; }
    .stale::before { content: ' · '; }
  }
</style>
