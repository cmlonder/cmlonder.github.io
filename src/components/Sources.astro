---
/**
 * Kaynaklar — makale sonu referans listesi.
 *
 * Eski hâli dört kolonluk bir denetim tablosuydu; okuru boğuyordu.
 * Doğrulama hâlâ çalışıyor, ama burada gürültü yapmadan duruyor:
 * eşleşmeyen satır işaretleniyor, gerisi sade bir kaynak listesi.
 */
interface Props { claims: any[]; checkedAt?: string }
const { claims, checkedAt } = Astro.props as Props;

const sourced = claims.filter((c) => c.url);
const passed  = claims.filter((c) => c.verdict === 'DOGRULANDI').length;
const missed  = claims.filter((c) => ['BULUNAMADI', 'ERISILEMEDI'].includes(c.verdict));

// Numaralandırma iddia SIRASINI takip eder: yazıdaki [1], buradaki 1.
// satırdır. URL tekrar edebilir — akademik atıfta da öyle.
const rows = claims.map((c, i) => ({
  n: i + 1,
  url: c.url as string | undefined,
  host: c.url ? new URL(c.url).hostname.replace(/^www\./, '') : null,
  claim: c.claim,
  date: c.sourceDate ? String(c.sourceDate).slice(0, 10) : null,
  miss: ['BULUNAMADI', 'ERISILEMEDI'].includes(c.verdict),
}));
---

{rows.length > 0 && (
  <section class="sources">
    <h2>Kaynaklar</h2>
    <ol>
      {rows.map((r) => (
        <li id={`k${r.n}`} class:list={[r.miss && 'miss']}>
          {r.url
            ? <a href={r.url} rel="noopener nofollow">{r.claim}</a>
            : <span>{r.claim}</span>}
          <span class="host">
            {r.host ?? 'kaynak verilmedi'}{r.date && <> · {r.date}</>}
            <a class="back" href={`#r${r.n}`} aria-label="metne dön">↩</a>
          </span>
          {r.miss && <span class="flag">bu kaynakta aranan değer bulunamadı</span>}
        </li>
      ))}
    </ol>
    <p class="note">
      {passed}/{claims.length} iddia kaynağından makineyle teyit edildi{checkedAt && checkedAt !== '—' ? `, ${checkedAt}` : ''}.
      {' '}<a href="/ai">Nasıl çalışıyor</a>.
    </p>
  </section>
)}

<style>
  .sources { margin-block-start: var(--s-2xl); }
  .sources h2 {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-muted);
    font-weight: 400;
    padding-block-end: var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
  .sources ol {
    list-style: decimal;
    padding-inline-start: 1.6em;
    margin-block: var(--s-s) 0;
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .sources li { margin-block-end: var(--s-xs); }
  .sources li::marker { color: var(--c-muted); }
  .sources li:target { background: color-mix(in srgb, var(--c-mark) 14%, transparent); }
  .back { margin-inline-start: .5em; text-decoration: none; }
  .sources a { overflow-wrap: anywhere; }
  .host {
    display: block;
    font-size: var(--t-xs);
    color: var(--c-muted);
  }
  .flag {
    display: block;
    font-size: var(--t-xs);
    color: var(--c-accent);
  }
  .note {
    margin-block-start: var(--s-m);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    color: var(--c-muted);
  }
</style>
