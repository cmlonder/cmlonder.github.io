---
import AiMark from './AiMark.astro';
/**
 * İçindekiler — yazılmamış bölümler dahil.
 *
 * Asıl fikir bu: iskelet ilk günden tam yayınlanıyor. Yazılmış bölüm
 * bağlantı, yazılmamış bölüm bir SÖZ — ne anlatacağını tek cümleyle
 * ilan ediyor. Boşluk saklanmıyor; hem okura harita hem yazara taahhüt.
 */
import { DOMAINS, DOMAIN_UI, type Locale } from '../config';
import { localePath } from '../lib/content';

interface Props {
  outline: { slug: string; title: string; promise: string; part?: string }[];
  /** Kitabın parçaları, sırasıyla. Bölümü olmayan parça da listede durur. */
  parts?: { name: string; blurb: string }[];
  yazilan: Map<string, any>;
  domain: string;
  lang: Locale;
  aktif?: string;
  compact?: boolean;
}
const { outline, parts = [], yazilan, domain, lang, aktif, compact = false } = Astro.props as Props;
const t = DOMAIN_UI[lang];

/*
 * Sıra parçalardan geliyor, bölümlerden değil: henüz tek bölümü
 * yazılmamış parça da listede duruyor — haritanın yarısını saklamak,
 * yazılmamış bölümü saklamakla aynı şey olurdu.
 *
 * Parçalarda adı geçmeyen bölüm kaybolmuyor: sonda kendi grubunda
 * toplanıyor. Ad değiştirirken sessizce düşmesin diye.
 */
const gruplar = parts.map((x) => ({
  ...x, items: outline.filter((b) => b.part === x.name),
}));
const adlar = new Set(parts.map((x) => x.name));
const artan = outline.filter((b) => !b.part || !adlar.has(b.part));
if (artan.length) gruplar.push({ name: '', blurb: '', items: artan });

const no = (slug: string) => outline.findIndex((b) => b.slug === slug) + 1;
---

<ol class:list={['outline', compact && 'compact']}>
  {gruplar.map((g) => (
    <>
      {g.name && (
        <li class:list={['part', !g.items.length && 'bos']} role="presentation">
          <span class="ad">{g.name}{!g.items.length && <em>{t.partNotStarted}</em>}</span>
          {!compact && g.blurb && <span class="pdek">{g.blurb}</span>}
        </li>
      )}
      {g.items.map((b) => {
        const var_ = yazilan.has(b.slug);
        const simdiki = aktif === b.slug;
        return (
          <li class:list={['row', !var_ && 'todo', simdiki && 'now']}>
            <span class="n">{String(no(b.slug)).padStart(2, '0')}</span>
            {var_ ? (
              <span class="txt">
                <a href={localePath(lang, DOMAINS.path, domain, b.slug)}
                   aria-current={simdiki ? 'page' : undefined}>{b.title}</a>
                {!compact && yazilan.get(b.slug).data.ai === 'generated' && <AiMark level="generated" lang={lang} mini />}
                {!compact && <span class="dek">{yazilan.get(b.slug).data.summary}</span>}
              </span>
            ) : (
              <span class="txt">
                <span class="t">{b.title}</span>
                {!compact && <span class="dek">{b.promise}</span>}
              </span>
            )}
          </li>
        );
      })}
    </>
  ))}
</ol>

<style>
  .outline { list-style: none; padding: 0; margin: 0; }

  .part {
    display: grid; gap: .3em;
    margin-block: var(--s-m) var(--s-2xs);
    padding-block-end: var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
  .part:first-child { margin-block-start: 0; }
  .part .ad {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .8em;
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .1em;
    color: var(--c-muted);
  }
  /* Bölümü yazılmamış parça: başlık aynı, yanında ne durumda olduğu.
     Solgunlaştırmıyoruz — harita eksik değil, henüz boş. */
  .part .ad em {
    font-style: normal; letter-spacing: .02em; text-transform: none;
    color: var(--c-mark-ink);
  }
  .part .pdek {
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: none; letter-spacing: 0;
    color: var(--c-muted); line-height: 1.45; max-inline-size: 60ch;
  }

  .row {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--s-2xs);
    align-items: baseline;
    padding-block: var(--s-2xs);
    position: relative;
  }
  .n {
    font-family: var(--f-mono); font-size: var(--t-xs);
    color: var(--c-muted); font-variant-numeric: tabular-nums;
  }
  .txt { display: grid; gap: .15em; justify-items: start; }
  .txt a, .txt .t {
    font-family: var(--f-serif); font-variation-settings: var(--axis-text);
    font-size: var(--t-sm); font-weight: 600; line-height: 1.3;
    text-decoration: none;
  }
  /* Yazılmış bölüm yalnızca renk ve kalınlıkla ayrışıyordu — WCAG 1.4.1
     rengi tek ayırt edici işaret olarak kullanmayı yasaklıyor. Altı
     çizili bir taban çizgisi ekleniyor. */
  .txt a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--c-accent) 35%, transparent);
    text-underline-offset: .18em;
    text-decoration-thickness: 1px;
  }
  .txt a:hover { color: var(--c-accent); text-decoration-color: currentColor; }
  .dek {
    font-family: var(--f-sans); font-size: var(--t-xs);
    color: var(--c-muted); line-height: 1.45;
  }

  /* Yazılmamış bölüm: solgun, italik söz, başlık bağlantı değil. */
  /* .45 opaklık numarayı 1.81:1'e düşürüyordu; ayrım renkle değil
     dolgusuz nokta ve italik sözle taşınıyor. */
  .todo .n { color: var(--c-muted); }
  .todo .txt .t { color: var(--c-muted); font-weight: 400; }
  .todo .dek { font-style: italic; }

  .now .n { color: var(--c-accent); }
  .now .txt a { color: var(--c-accent); }
  .now::before {
    content: '';
    position: absolute;
    inset-inline-start: -.8rem;
    inset-block: .55em auto;
    inline-size: 3px; block-size: 1em;
    border-radius: 2px;
    background: var(--c-accent);
  }

  .compact .row { padding-block: .3em; grid-template-columns: 2rem 1fr; }
  .compact .txt a, .compact .txt .t { font-size: var(--t-xs); font-weight: 400; }
  .compact .part { margin-block: var(--s-s) var(--s-3xs); gap: 0; }
</style>
