---
import GrowthBadge from './GrowthBadge.astro';
import { COLLECTION_LABELS, STATUS_LABELS, TOPIC_LABELS,
         type CollectionName, type Locale, type Topic } from '../config';
import TypeMark from './TypeMark.astro';
import { formatDate, relativeDate, entryPath, parseId } from '../lib/content';
import type { AnyEntry } from '../lib/content';

interface Props {
  collection: CollectionName;
  entry: AnyEntry;
  lang: Locale;
  /** card: kenarlıklı kart (Essays/Playbooks) · row: ikonlu liste satırı (Notes/Signals) */
  variant?: 'card' | 'row';
  showCollection?: boolean;
  /** Satırlarda açıklama göster (liste sayfaları evet, anasayfa hayır). */
  showDescription?: boolean;
  /**
   * Başlık etiketi. Ebeveyn bağlamına göre ayarlanır — h1'in hemen altındaki
   * listede h2, bir bölüm başlığının altındaysa h3 olmalı.
   */
  as?: 'h2' | 'h3';
}
const {
  collection, entry, lang,
  variant = 'card', showCollection = false, showDescription = false, as = 'h3',
} = Astro.props as Props;
const Heading = as;

const { slug } = parseId(entry.id);
const d = entry.data as AnyEntry['data'] & Record<string, any>;
const href = entryPath(lang, collection, slug);
const typeLabel = COLLECTION_LABELS[collection][lang].replace(/lar$|ler$|s$/, '');
// Kapakta illüstrasyon yok — kopyalanacak çizim yok, uydurma da yok.
// Yerine yazının ana konusu tipografik olarak duruyor.
const coverTopic = TOPIC_LABELS[(d.topics as Topic[])[0]][lang];
---

{variant === 'card' ? (
  <article class="card">
    <a class="cover" href={href} aria-hidden="true" tabindex="-1">
      <span class="glyph">{coverTopic}</span>
    </a>
    <div class="body">
      <Heading><a href={href}>{d.title}</a></Heading>
      <p class="dek">{d.description}</p>
      <p class="foot meta">
        <span>{typeLabel}</span>
        <span class="mark"><TypeMark collection={collection} size={13} /></span>
        <time datetime={d.pubDate.toISOString()} title={formatDate(d.pubDate, lang)}>{relativeDate(d.pubDate, lang)}</time>
      </p>
    </div>
  </article>
) : (
  <article class="row">
    <span class="mark"><TypeMark collection={collection} /></span>
    <div>
      <Heading><a href={href}>{d.title}</a></Heading>
      {showDescription && <p class="dek">{d.description}</p>}
      <p class="foot meta">
        {showCollection && <><span class="coll">{typeLabel}</span><span aria-hidden="true">·</span></>}
        <time datetime={d.pubDate.toISOString()} title={formatDate(d.pubDate, lang)}>{relativeDate(d.pubDate, lang)}</time>
        {d.status && (
          <><span aria-hidden="true">·</span><GrowthBadge status={d.status} lang={lang} /></>
        )}
        {collection === 'signals' && (<><span aria-hidden="true">·</span><span>{d.source}</span></>)}
      </p>
    </div>
  </article>
)}

<style>
  h2, h3 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    line-height: var(--lh-snug);
    font-size: var(--t-base);
  }
  h2 a, h3 a { text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--c-accent); }

  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: .5em; }
  .mark { color: var(--c-mark); display: inline-flex; }

  /* — Kart — */
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 140ms ease, transform 140ms ease;
  }
  .card:hover { border-color: var(--c-accent); transform: translateY(-2px); }

  /* İllüstrasyon yerine sakin bir tip-levhası: kopyalanacak çizim yok. */
  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 2;
    padding: var(--s-2xs);
    background: var(--c-tinted);
    border-block-end: 1px solid var(--c-border);
    text-decoration: none;
  }
  .glyph {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-md);
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
    color: var(--c-muted);
  }
  .card:hover .cover { background: var(--c-border); }

  .card .body { display: grid; gap: var(--s-3xs); padding: var(--s-xs); }
  .dek {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--c-muted);
  }

  /* — Satır — */
  .row { display: grid; grid-template-columns: auto 1fr; gap: var(--s-2xs); align-items: start; }
  .row .dek { margin-block: .25em .15em; }
  .row .mark { padding-block-start: .3em; }
  .row .coll { color: var(--c-accent); }
</style>
