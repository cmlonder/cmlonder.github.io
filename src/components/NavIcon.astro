---
/**
 * Menü ikonları — her bölüm için bir işaret.
 *
 * Emoji değil SVG: emoji platformdan platforma değişiyor ve sitenin
 * tonuna oturmuyor. Hepsi aynı kalem kalınlığında, aynı 24'lük ızgarada.
 */
interface Props { name: string }
const { name } = Astro.props as Props;
const P = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6,
            'stroke-linecap': 'round' as const, 'stroke-linejoin': 'round' as const };
---
<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" {...P}>
  {name === 'workbench' && <><path d="M3 9h18M5 9V6h14v3M6 9v10M18 9v10M9 13h6" /></>}
  {name === 'essays' && <><path d="M6 3h9l4 4v14H6z" /><path d="M15 3v4h4M9 12h6M9 16h4" /></>}
  {name === 'notes' && <><path d="M5 4h14v13l-4 4H5z" /><path d="M19 17h-4v4M8 9h8M8 13h5" /></>}
  {name === 'playbooks' && <><path d="M4 5h7v15H4zM13 5h7v15h-7z" /><path d="M7 9h1M16 9h1" /></>}
  {name === 'signals' && <><path d="M12 12v0" /><circle cx="12" cy="12" r="1.6" /><path d="M8.5 15.5a5 5 0 0 1 0-7M15.5 8.5a5 5 0 0 1 0 7M5.5 18.5a9 9 0 0 1 0-13M18.5 5.5a9 9 0 0 1 0 13" /></>}
  {name === 'library' && <><path d="M5 4h5v16H5zM12 4h3v16h-3z" /><path d="M17 5l3 14-2 .5-3-14z" /></>}
  {name === 'films' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M7 5v14M17 5v14M3 12h18" /></>}
  {name === 'games' && <><rect x="2.5" y="7" width="19" height="10" rx="4" /><path d="M7 10v4M5 12h4M15.5 11.5v.01M18 13.5v.01" /></>}
  {name === 'skills' && <><path d="M12 3l2.6 5.6L21 9.5l-4.5 4.3 1.1 6.2L12 17l-5.6 3 1.1-6.2L3 9.5l6.4-.9z" /></>}
  {name === 'radar' && <><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4" /><path d="M12 12L18 7" /></>}
  {name === 'domains' && <><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17" /></>}
</svg>
