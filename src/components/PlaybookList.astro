---
/**
 * Kılavuzlar — karar kataloğu.
 *
 * Bir playbook'a başlığı için değil, PROBLEMİ için bakılır. O yüzden
 * burada önce problem cümlesi duruyor, başlık onun altında. Belirtiler
 * (symptoms) de görünür: okuyucu kendi durumunu listede tanıyor.
 */
import { entryPath, parseId } from '../lib/content';
import type { AnyEntry } from '../lib/content';
import type { Locale } from '../config';

interface Props { entries: AnyEntry[]; lang: Locale }
const { entries, lang } = Astro.props as Props;
const t = { problem: lang === 'tr' ? 'Problem' : 'Problem' };
---

<ul class="katalog">
  {entries.map((e) => { const d = e.data as any; return (
    <li>
      <a href={entryPath(lang, 'playbooks', parseId(e.id).slug)}>
        <p class="lbl">{t.problem}</p>
        <p class="problem">{d.problem}</p>
        <h2>{d.title}</h2>
        <p class="context">{d.context}</p>
      </a>
    </li>
  ); })}
</ul>

<style>
  .katalog { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-m); }
  .katalog a {
    display: block; text-decoration: none;
    padding: var(--s-m);
    border: 1px solid var(--c-border); border-radius: var(--radius-lg);
    background: var(--c-surface);
    transition: border-color .18s ease;
  }
  .katalog a:hover { border-color: color-mix(in srgb, var(--c-accent) 45%, var(--c-border)); }

  /*
   * Hiyerarşi: PROBLEM etiketi (küçük), problem cümlesi (büyük serif),
   * sonra başlık. Önce başlığı küçük büyük harfle yazmıştım; kartın
   * asıl adı kaybolmuş, sıralama kaymış gibi duruyordu.
   */
  .lbl {
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em;
    color: var(--c-muted);
  }
  .problem {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif); font-size: var(--t-md);
    line-height: 1.35; color: var(--c-text); text-wrap: pretty;
  }
  .katalog h2 {
    margin-block-start: var(--s-s);
    padding-block-start: var(--s-2xs);
    border-block-start: 1px solid var(--c-border);
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-base); line-height: var(--lh-snug);
    color: var(--c-text);
    transition: color .18s ease;
  }
  .katalog a:hover h2 { color: var(--c-accent); }
  .context {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-sans); font-size: var(--t-sm);
    color: var(--c-muted); line-height: 1.5; text-wrap: pretty;
  }
  @media (prefers-reduced-motion: reduce) { .katalog a, .katalog h2 { transition: none; } }
</style>
