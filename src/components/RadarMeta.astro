---
/**
 * Bültenin künyesi — vaka bazlı, toplu istatistik değil.
 * Tek bir bültenle bile anlamlı; alan yoksa hiç görünmüyor.
 */
import { RADAR_CATEGORY, RADAR_REVENUE_SOURCE } from '../config';

interface Props { data: any }
const { data } = Astro.props as Props;

const cat = data.category ? (RADAR_CATEGORY[data.category] ?? data.category) : null;
const rows = [
  data.revenue_source && { k: 'Ciro kaynağı', v: RADAR_REVENUE_SOURCE[data.revenue_source] ?? data.revenue_source },
].filter(Boolean) as { k: string; v: string }[];

const tags: string[] = data.tags ?? [];
---

{(cat || rows.length || tags.length) && (
  <aside class="rmeta">
    {cat && <a class="cat" href={`/radar/kategori/${data.category}`}>{cat}</a>}
    {rows.map((r) => (
      <span class="row"><span class="k">{r.k}</span><span class="v">{r.v}</span></span>
    ))}
    {tags.length > 0 && (
      <span class="row tags">
        <span class="k">Etiket</span>
        <span class="v">{tags.map((t) => <span class="tag">{t}</span>)}</span>
      </span>
    )}
  </aside>
)}

<style>
  .rmeta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2xs) var(--s-s);
    margin-block: var(--s-m) 0;
    padding-block: var(--s-2xs);
    border-block: 1px solid var(--c-border);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
  }
  .cat {
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--c-accent);
    text-decoration: none;
  }
  .cat:hover { text-decoration: underline; }
  .row { display: inline-flex; gap: .45em; align-items: baseline; }
  .k { color: var(--c-muted); }
  .v { color: var(--c-text); }
  .tags .v { display: inline-flex; flex-wrap: wrap; gap: .3em; }
  .tag {
    padding: .1em .5em;
    border: 1px solid var(--c-border);
    border-radius: 99px;
    color: var(--c-muted);
  }
</style>
