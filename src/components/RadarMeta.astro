---
/**
 * Bültenin gezinme şeridi: kategori + etiketler, hepsi tıklanabilir.
 *
 * Eskiden burada "Durum / Savunma hattı / Yığın / Ciro kaynağı" diye bir
 * künye tablosu vardı — künye tabelası gibi duruyordu ve çoğu tıklanamıyordu.
 * Artık yalnızca GEZİNME var; ciro kaynağı kaynak listesinin yanına taşındı,
 * çünkü o bir künye değil, kaynak bilgisi.
 */
import { RADAR_CATEGORY, topicLabel } from '../config';

interface Props { data: any }
const { data } = Astro.props as Props;

// Slug URL'de yaşıyor, etiket ekranda. Sözlükte yoksa slug ham gösteriliyor.
const etiket = (t: string) => topicLabel(t, 'tr');

const cat: string | null = data.category ?? null;
const tags: string[] = data.topics ?? [];
const saglik: number | null = data.health_score ?? null;
---

{(cat || tags.length > 0 || saglik) && (
  <nav class="chips" aria-label="Kategori ve etiketler">
    {cat && (
      <a class="chip cat" href={`/radar/category/${cat}`}>
        {RADAR_CATEGORY[cat] ?? cat}
      </a>
    )}
    {tags.map((t) => (
      <a class="chip tag" href={`/radar/topic/${t}`}>{etiket(t)}</a>
    ))}
    {saglik && (
      <span class="chip saglik" title="Ajanın tahmini: issue kapanma hızı, sürüm düzeni, bakımcı ekibi">
        <span class="lbl">Sağlık</span>
        <span class="bar" aria-hidden="true"><span style={`--p:${saglik * 10}%`} /></span>
        {saglik}/10
      </span>
    )}
  </nav>
)}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-block: var(--s-m) var(--s-l);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-block-size: 32px;
    padding-inline: .85em;
    border-radius: 999px;
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .15s ease, color .15s ease, border-color .15s ease;
  }
  .cat {
    color: var(--c-accent);
    background: color-mix(in srgb, var(--c-accent) 11%, transparent);
    font-weight: 600;
    letter-spacing: .01em;
  }
  .cat:hover { background: color-mix(in srgb, var(--c-accent) 20%, transparent); }
  .tag {
    color: var(--c-muted);
    border: 1px solid var(--c-border);
  }
  .tag::before { content: '#'; opacity: .5; margin-inline-end: .15em; }
  .tag:hover { color: var(--c-accent); border-color: currentColor; }
  /* Sağlık puanı: gezinme değil ölçüm — dolgusuz, minik bir çubukla. */
  .saglik { gap: .5em; color: var(--c-muted); border: 1px dashed var(--c-border); font-variant-numeric: tabular-nums; cursor: help; }
  .saglik .lbl { text-transform: uppercase; letter-spacing: .06em; font-size: .85em; }
  .saglik .bar { inline-size: 3.5rem; block-size: 4px; border-radius: 2px; background: var(--c-border); overflow: hidden; }
  .saglik .bar > span { display: block; block-size: 100%; inline-size: var(--p); background: var(--c-accent); }
</style>
