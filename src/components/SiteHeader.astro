---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import {
  SITE, COLLECTIONS, COLLECTION_LABELS, COLLECTION_BLURBS,
  HUB, NAV, SHELVES, SHELF_NAMES, RADAR, DOMAINS, PROJECTS, type Locale,
} from '../config';
import NavIcon from './NavIcon.astro';
import { localePath } from '../lib/content';

interface Props {
  lang: Locale;
  altLocale?: { lang: Locale; href: string } | null;
}
const { lang, altLocale = null } = Astro.props;
const menuLabel = lang === 'tr' ? 'Bölümler' : 'Sections';
---

<header class="site-header">
  <div class="bar">
    <a class="wordmark" href={localePath(lang, '')}>
      <span class="leaf" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
             stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20c0-7 5-12 12-12" /><path d="M16 8c0 5-4 8-8 8" />
        </svg>
      </span>
      {SITE.author}
    </a>

    <nav aria-label={menuLabel}>
      {/* Maggie'nin "The Garden ⌄" megamenu kalıbı: tek dropdown, içinde
          bölümler ve her birinin tek cümlelik tarifi. */}
      <details class="hub">
        <summary>
          {HUB.name[lang]}
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="menu">
          <a class="item all" href={localePath(lang, HUB.path)}>
            <NavIcon name="workbench" />
            <span class="txt">
              <strong>{HUB.name[lang]}</strong>
              <span class="dek">{HUB.blurb[lang]}</span>
            </span>
          </a>

          {COLLECTIONS.map((c) => (
            <a class="item" href={localePath(lang, c)}>
              <NavIcon name={c} />
              <span class="txt">
                <strong>{COLLECTION_LABELS[c][lang]}</strong>
                <span class="dek">{COLLECTION_BLURBS[c][lang]}</span>
              </span>
            </a>
          ))}

          {SHELF_NAMES.map((s) => (
            <a class="item" href={localePath(lang, SHELVES[s].path)}>
              <NavIcon name={s} />
              <span class="txt">
                <strong>{SHELVES[s].name[lang]}</strong>
                <span class="dek">{SHELVES[s].blurb[lang]}</span>
              </span>
            </a>
          ))}

          <a class="item" href={localePath(lang, PROJECTS.path)}>
            <NavIcon name="projects" />
            <span class="txt">
              <strong>{PROJECTS.name[lang]}</strong>
              <span class="dek">{PROJECTS.blurb[lang]}</span>
            </span>
          </a>

          <a class="item" href={localePath(lang, DOMAINS.path)}>
            <NavIcon name="domains" />
            <span class="txt">
              <strong>{DOMAINS.name[lang]}</strong>
              <span class="dek">{DOMAINS.blurb[lang]}</span>
            </span>
          </a>

          {/* Radar makine üretimi — menüde de ayrılıyor, dil bağımsız tek adres. */}
          <a class="item machine" href="/radar">
            <NavIcon name="radar" />
            <span class="txt">
              <strong>{RADAR.name[lang]}<span class="tag">makine</span></strong>
              <span class="dek">{RADAR.blurb[lang]}</span>
            </span>
          </a>
        </div>
      </details>

      {NAV[lang].map((item) => (
        <a class="top" href={localePath(lang, item.href.replace(/^\//, ''))}>{item.label}</a>
      ))}
    </nav>

    <div class="controls">
      <Search lang={lang} />
      {altLocale && (
        <a class="lang" href={altLocale.href} lang={altLocale.lang}>{altLocale.lang.toUpperCase()}</a>
      )}
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header { padding-block: var(--s-s); }

  /*
   * Şerit içerikle AYNI kaba kilitliydi: 1920px'te kontroller sağ
   * kenardan 384px içeride kalıyordu. Başlık bir kılıf, içerikse okuma
   * ölçüsü — ikisinin aynı genişlikte olması gerekmiyor. Şerit kenara
   * yaklaşıyor, gövde ölçüsünü koruyor.
   */
  .bar {
    /* Menü buna göre konumlanıyor: tetikleyiciye değil ŞERİDİN SAĞ
       KENARINA yaslanıyor, yoksa geniş ekranda sağında boşluk kalıyor. */
    position: relative;
    /* Üst sınır yok: şerit ekranla birlikte genişliyor, kenardan
       yalnızca akışkan bir boşluk bırakıyor. Kontroller böylece her
       genişlikte sağ kenara yakın duruyor. */
    inline-size: 100%;
    padding-inline: clamp(var(--s-s), 3vw, var(--s-xl));
    box-sizing: border-box;
  }

  .bar { display: flex; align-items: center; gap: var(--s-s); flex-wrap: wrap; }

  /* Arama, dil ve tema düğmeleri. Bu kuralın yokluğu üçünü üst üste
     diziyordu: .search blok seviyesinde, .controls varsayılan block.
     Başlık şeridi her sayfada 145px'e şişiyordu. */
  .controls {
    display: flex;
    align-items: center;
    gap: var(--s-2xs);
    flex-shrink: 0;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-block-size: 24px;
    gap: var(--s-3xs);
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-sm);
    font-weight: 700;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .leaf { color: var(--c-mark); }

  nav {
    display: flex;
    align-items: center;
    gap: var(--s-s);
    font-family: var(--f-sans);
    font-size: var(--t-sm);
  }
  /* WCAG 2.2 AA 2.5.8: en küçük hedef 24x24. Bağlantılar 23px'ti. */
  /* WCAG 2.2 AA 2.5.8: dil anahtarı 25x21 idi. */
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 24px;
    min-inline-size: 28px;
    text-decoration: none;
  }
  nav a.top { text-decoration: none; display: inline-flex; align-items: center; min-block-size: 24px; }
  .hub summary { min-block-size: 24px; }

  /* — Megamenu — */
  .hub { position: static; }
  .hub summary {
    display: inline-flex;
    align-items: center;
    gap: .35em;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .hub summary::-webkit-details-marker { display: none; }
  .hub summary:hover { color: var(--c-accent); }
  .hub[open] summary svg { transform: rotate(180deg); }
  .hub summary svg { transition: transform 150ms ease; }

  /* — Menü ızgarası —
     Eskiden dikey bir listeydi ve on bir öğeyle aşağı doğru uzayıp
     gidiyordu. Izgara hem daha az yer kaplıyor hem de bölümleri yan yana
     karşılaştırılabilir hale getiriyor. */
  .menu {
    position: absolute;
    /* Şeridin altına, sağ kenar boşluğuyla hizalı. */
    inset-block-start: calc(100% + var(--s-2xs));
    inset-inline-end: clamp(var(--s-s), 3vw, var(--s-xl));
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(2, minmax(15rem, 1fr));
    gap: var(--s-3xs);
    padding: var(--s-xs);
    inline-size: max-content;
    max-inline-size: min(38rem, calc(100vw - var(--s-m)));
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--c-text) 55%, transparent);
  }

  .item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2xs);
    align-items: start;
    padding: var(--s-2xs);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    transition: background-color .14s ease, color .14s ease;
  }
  .item:hover, .item:focus-visible { background: var(--c-tinted); }
  .item :global(svg) {
    color: var(--c-muted);
    margin-block-start: 1px;
    transition: color .14s ease;
  }
  .item:hover :global(svg) { color: var(--c-accent); }

  .txt { display: grid; gap: .1em; min-inline-size: 0; }
  .item strong {
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: .5em;
  }
  .item .dek {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    color: var(--c-muted);
    line-height: 1.4;
  }

  /* Bahçe bütün akışı topluyor. Eskiden ızgarayı boydan boya
     kaplıyordu ama bu ritmi bozuyordu — artık eşit hücre, farkı
     zeminden anlaşılıyor. */
  .item.all { background: var(--c-tinted); }
  .item.all:hover { background: color-mix(in srgb, var(--c-accent) 9%, var(--c-tinted)); }

  /* Radar makine üretimi; ayrımı yayılmayla değil kenar çizgisiyle. */
  .item.machine { box-shadow: inset 2px 0 0 color-mix(in srgb, var(--c-accent) 45%, transparent); }
  .item.machine :global(svg) { color: var(--c-accent); opacity: .75; }
  .tag {
    font-size: var(--t-xs);
    font-weight: 400;
    padding: .1em .5em;
    border-radius: 999px;
    color: var(--c-accent);
    background: color-mix(in srgb, var(--c-accent) 11%, transparent);
  }

  @media (max-width: 52rem) {
    .menu {
      grid-template-columns: 1fr 1fr;
      inline-size: calc(100vw - var(--s-m));
      max-inline-size: none;
    }
  }
  @media (max-width: 40rem) {
    /* 390px'te sözcük markası + dört bağlantı + üç düğme tek satıra
       sığmıyordu; sayfa 402px'e taşıyordu. Gezinme ikinci satıra iniyor. */
    .bar > nav { order: 3; flex-basis: 100%; justify-content: flex-start; gap: var(--s-s); }
    .wordmark { margin-inline-end: auto; }
  }
  @media (max-width: 34rem) {
    .menu { grid-template-columns: 1fr; }
    .item .dek { display: none; }
    .item { min-block-size: 44px; align-items: center; }
  }
</style>

<script>
  // Dışarı tıklayınca veya Esc ile megamenu kapansın.
  const hub = document.querySelector('details.hub') as HTMLDetailsElement | null;
  if (hub) {
    document.addEventListener('click', (e) => {
      if (hub.open && !hub.contains(e.target as Node)) hub.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hub.open) hub.open = false;
    });
  }
</script>
