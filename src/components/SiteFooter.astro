---
import {
  SITE, COLLECTIONS, COLLECTION_LABELS, HUB, NAV, LIBRARY, SKILLS, RADAR, type Locale,
} from '../config';
import { localePath } from '../lib/content';

interface Props { lang: Locale }
const { lang } = Astro.props;

const t = lang === 'tr'
  ? { cta: 'Haberdar olmak ister misin?', rss: 'RSS ile takip et', map: 'Site haritası' }
  : { cta: 'Want to stay up to date?', rss: 'Subscribe via RSS', map: 'Sitemap' };

const links = [
  { label: HUB.name[lang], href: localePath(lang, HUB.path) },
  ...COLLECTIONS.map((c) => ({ label: COLLECTION_LABELS[c][lang], href: localePath(lang, c) })),
  { label: LIBRARY.name[lang], href: localePath(lang, LIBRARY.path) },
  { label: SKILLS.name[lang], href: localePath(lang, SKILLS.path) },
  { label: RADAR.name[lang], href: '/radar' },
  { label: lang === 'tr' ? 'Yapay zeka kullanımı' : 'AI usage', href: localePath(lang, 'ai') },
  ...NAV[lang].map((n) => ({ label: n.label, href: localePath(lang, n.href.replace(/^\//, '')) })),
];

// Bu path'ler DOLGU için çizilmiş — stroke ile çizilirse bozuk görünür.
const social = [
  {
    name: 'GitHub',
    href: 'https://github.com/cmlonder',
    d: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/cmlonder/',
    d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05a4.2 4.2 0 0 1 3.8-2.1c4 0 4.8 2.6 4.8 6.1V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9V9Z',
  },
];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="cta">
      <h2>{t.cta}</h2>

      <a class="rss" href={localePath(lang, 'rss.xml')}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 11a9 9 0 0 1 9 9" /><path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        {t.rss}
      </a>

      <ul class="social">
        {social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" aria-label={s.name}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                   fill="currentColor">
                <path d={s.d} />
              </svg>
            </a>
          </li>
        ))}
      </ul>

      <p class="copyright meta">© {new Date().getFullYear()} {SITE.author}</p>
    </div>

    <nav class="sitemap" aria-label={t.map}>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--c-border);
    padding-block: var(--s-xl) var(--s-2xl);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-l);
    align-items: start;
  }

  .cta h2 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    font-size: var(--t-md);
    line-height: var(--lh-snug);
  }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: .5em;
    margin-block-start: var(--s-2xs);
    padding: .4em .9em;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    background: var(--c-surface);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    text-decoration: none;
  }
  .rss:hover { border-color: var(--c-accent); }

  .social {
    display: flex;
    gap: var(--s-2xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-xs);
    color: var(--c-muted);
  }
  .social a { display: inline-flex; }
  .social a:hover { color: var(--c-accent); }

  .copyright { margin-block-start: var(--s-xs); }

  /* Maggie'nin iki kolonlu sitemap'i */
  .sitemap ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3xs) var(--s-m);
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    color: var(--c-muted);
  }
  .sitemap a { text-decoration: none; }

  @media (max-width: 40rem) {
    .grid { grid-template-columns: 1fr; gap: var(--s-l); }
  }
</style>
