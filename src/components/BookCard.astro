---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

/**
 * Kapak konvansiyonla bulunuyor: src/assets/covers/<slug>.jpg
 * scripts/fetch-covers.mjs Open Library'den indiriyor ve repoda tutuyor.
 * Dosya yoksa aşağıdaki tipografik kapağa düşüyoruz.
 */
const kapaklar = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/covers/*.{jpg,jpeg,png,webp}', { eager: true });

interface Props {
  entry: CollectionEntry<'library'>;
  /** Anasayfada not gizlenir; /library sayfasında görünür. */
  compact?: boolean;
}
const { entry, compact = false } = Astro.props;
const d = entry.data;

/** Kapak görseli yok — kitap kapağı taramıyoruz. Tipografik kapak üretiyoruz. */
const slug = entry.id.split('/').pop();
const kapakYolu = Object.keys(kapaklar).find((k) => k.endsWith(`/${slug}.jpg`)
  || k.endsWith(`/${slug}.jpeg`) || k.endsWith(`/${slug}.png`) || k.endsWith(`/${slug}.webp`));
const kapak = kapakYolu ? kapaklar[kapakYolu].default : null;

const tone = [...d.title].reduce((n, ch) => n + ch.charCodeAt(0), 0) % 4;
const Wrapper = d.url ? 'a' : 'div';
---

<article class="book">
  {/* Kapak başlığı taşıyor — altında tekrar etmiyoruz. */}
  <Wrapper class:list={['cover', !kapak && `tone-${tone}`, kapak && 'has-img']}
           {...(d.url ? { href: d.url, rel: 'noopener' } : {})}>
    {kapak
      ? <Image src={kapak} alt={`${d.title} — ${d.author}`} widths={[180, 360]}
               sizes="(max-width: 46rem) 40vw, 180px" loading="lazy" />
      : <><span class="t">{d.title}</span><span class="a">{d.author}</span></>}
  </Wrapper>
  <p class="meta">{d.year}</p>
  {!compact && <p class="note">{d.note}</p>}
</article>

<style>
  .book { display: grid; gap: var(--s-3xs); }

  .cover.has-img {
    display: block;
    padding: 0;
    border-color: color-mix(in srgb, var(--c-text) 14%, transparent);
    background: var(--c-tinted);
  }
  .cover.has-img :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  .cover {
    aspect-ratio: 2 / 3;
    display: grid;
    align-content: space-between;
    gap: var(--s-2xs);
    padding: var(--s-2xs);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-tinted);
    overflow: hidden;
  }
  /* Dört sakin ton — palet dışına çıkmadan ızgarada ritim kurar. */
  .tone-0 { background: color-mix(in srgb, var(--c-accent) 8%, var(--c-tinted)); }
  .tone-1 { background: color-mix(in srgb, var(--c-mark) 10%, var(--c-tinted)); }
  .tone-2 { background: var(--c-tinted); }
  .tone-3 { background: color-mix(in srgb, var(--c-text) 6%, var(--c-tinted)); }

  .cover .t {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-sm);
    line-height: 1.15;
    text-wrap: balance;
  }
  .cover .a {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    color: var(--c-muted);
  }

  a.cover { text-decoration: none; transition: border-color 140ms ease; }
  a.cover:hover { border-color: var(--c-accent); }

  .meta { margin-block-start: var(--s-3xs); }

  .note {
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--c-muted);
  }
</style>
