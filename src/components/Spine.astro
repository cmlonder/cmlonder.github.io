---
/**
 * Kitap omurgası — domain bölümlerinin listesi, okuma sayfasının solunda.
 *
 * Yazı sayfalarındaki içindekiler paneliyle aynı yuvada durur (.toc-col):
 * sabit, yarı saydam, oluğa sığar, dar ekranda <details> olur. Yazılmış
 * bölüm bağlantı, yazılmamış bölüm sönük metin; okunan bölüm aksanlı.
 */
import { DOMAINS, DOMAIN_UI, type Locale } from '../config';
import { localePath } from '../lib/content';

interface Props {
  title: string;
  outline: { slug: string; title: string; part?: string }[];
  yazilan: Map<string, any>;
  domain: string;
  lang: Locale;
  aktif?: string;
  /** 'col' = sabit panel, 'mobile' = yazı başındaki <details> */
  variant?: 'col' | 'mobile';
}
const { title, outline, yazilan, domain, lang, aktif, variant = 'col' } = Astro.props as Props;
const t = DOMAIN_UI[lang];
const no = (i: number) => String(i + 1).padStart(2, '0');
const href = (b: { slug: string }) => localePath(lang, DOMAINS.path, domain, b.slug);
const satirlar = outline.map((b, i) => ({ b, i, var_: yazilan.has(b.slug) }));
---

{variant === 'col' ? (
  <nav class="toc spine" aria-label={title}>
    <p class="toc-h"><a class="toc-up" href={localePath(lang, DOMAINS.path, domain)}>{title}</a></p>
    <ol>
      {satirlar.map(({ b, i, var_ }) => (
        <li>
          {var_
            ? <a href={href(b)} data-aktif={aktif === b.slug ? '' : undefined}
                 aria-current={aktif === b.slug ? 'page' : undefined}>
                <span class="toc-n">{no(i)}</span>{b.title}
              </a>
            : <span class="toc-todo"><span class="toc-n">{no(i)}</span>{b.title}</span>}
        </li>
      ))}
    </ol>
  </nav>
) : (
  <details class="toc-mobil">
    <summary>{title} · {t.contents}</summary>
    <ol>
      {satirlar.map(({ b, i, var_ }) => (
        <li>
          {var_
            ? <a href={href(b)} aria-current={aktif === b.slug ? 'page' : undefined}>
                <span class="toc-n">{no(i)}</span>{b.title}
              </a>
            : <span class="toc-todo"><span class="toc-n">{no(i)}</span>{b.title}</span>}
        </li>
      ))}
    </ol>
  </details>
)}
