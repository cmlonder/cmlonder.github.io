---
import Base from '../../layouts/Base.astro';
import { TOPICS, TOPIC_LABELS, UI, type Locale, PAGE } from '../../config';
import { getTopicCounts, localePath, countLabel } from '../../lib/content';

const lang: Locale = 'en';
const other = 'tr' as const;
const counts = await getTopicCounts(lang);

const blurb = PAGE[lang].topicsBlurb;
---

<Base title={`${UI[lang].topics} — Cemal Önder`} description={blurb} lang={lang}
      altLocale={{ lang: other, href: localePath(other, 'topics') }}>
  <div class="wrap">
    <h1>{UI[lang].topics}</h1>
    <p class="blurb">{blurb}</p>

    <ul class="topics">
      {TOPICS.map((topic) => {
        const n = counts.get(topic) ?? 0;
        return (
          <li class:list={{ empty: n === 0 }}>
            {/* Henüz yazı olmayan konu link değil — boş sayfaya göndermeyelim,
                ama altı sütun görünür kalsın: sitenin kapsamını ilan ediyor. */}
            {n > 0
              ? <a href={localePath(lang, 'topics', topic)}>{TOPIC_LABELS[topic][lang]}</a>
              : <span class="name">{TOPIC_LABELS[topic][lang]}</span>}
            <span class="meta">{countLabel(n, lang)}</span>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  h1 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-3xl);
    font-weight: 400;
    line-height: var(--lh-tight);
    letter-spacing: -0.02em;
  }
  .blurb {
    margin-block-start: var(--s-2xs);
    max-inline-size: 38ch;
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-size: var(--t-lg);
    line-height: 1.25;
    color: var(--c-muted);
  }
  .topics {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-l);
    display: grid;
    gap: 0;
  }
  .topics li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2xs);
    padding-block: var(--s-xs);
    border-block-start: 1px solid var(--c-border);
  }
  .topics li:last-child { border-block-end: 1px solid var(--c-border); }
  .topics a, .topics .name {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    text-decoration: none;
  }
  .topics li.empty { color: var(--c-muted); }
</style>
