---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PROJECTS, PROJECT_STATUS, PROJECT_UI, type Locale } from '../../config';
import { localePath, formatDate } from '../../lib/content';

const lang: Locale = 'en';
const all = await getCollection('projects');
const kendi = all.filter((e) => e.id.startsWith(`${lang}/`));
const items = (kendi.length ? kendi : all.filter((e) => e.id.startsWith('tr/')))
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${PROJECTS.name[lang]} — Cemal Önder`} description={PROJECTS.blurb[lang]} lang={lang}>
  <div class="wrap">
    <header class="head">
      <h1>{PROJECTS.name[lang]}</h1>
      <p class="blurb">{PROJECTS.blurb[lang]}</p>
    </header>

    <ul class="list">
      {items.map((e) => (
        <li>
          <a href={localePath(lang, PROJECTS.path, e.id.split('/').pop()!)}>
            <p class="top">
              <span class="st" data-s={e.data.status}>{PROJECT_STATUS[e.data.status][lang]}</span>
              <time datetime={e.data.started.toISOString()}>{formatDate(e.data.started, lang)}</time>
            </p>
            <h2>{e.data.title}</h2>
            <p class="what">{e.data.what}</p>

            {e.data.metrics.length > 0 && (
              <dl class="m">
                {e.data.metrics.map((m) => (<div><dt>{m.value}</dt><dd>{m.label}</dd></div>))}
              </dl>
            )}

            {e.data.stack.length > 0 && (
              <p class="stack">{e.data.stack.map((s) => <code>{s}</code>)}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .wrap { max-inline-size: var(--w-page); margin-inline: auto; }
  .head { margin-block-end: var(--s-2xl); max-inline-size: 60ch; }
  h1 { font-family: var(--f-serif); font-variation-settings: var(--axis-display);
       font-weight: 400; line-height: var(--lh-tight); }
  .blurb { margin-block-start: var(--s-2xs); font-family: var(--f-serif);
           font-size: var(--t-md); color: var(--c-muted); line-height: 1.35; }

  .list { list-style: none; padding: 0; display: grid; gap: var(--s-m);
          grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); }
  .list a {
    display: block; block-size: 100%; text-decoration: none;
    padding: var(--s-m);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    transition: border-color .15s ease, transform .15s ease;
  }
  .list a:hover { border-color: color-mix(in srgb, var(--c-accent) 40%, var(--c-border));
                  transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .list a, .list a:hover { transition: none; transform: none; } }

  .top { display: flex; justify-content: space-between; align-items: baseline;
         gap: var(--s-s); font-family: var(--f-sans); font-size: var(--t-xs); }
  .st {
    padding: .15em .6em; border-radius: 999px;
    text-transform: uppercase; letter-spacing: .06em;
  }
  /* Durum bir vitrin değil; arşivlenmiş proje de gösterilir. */
  .st[data-s='live']     { color: var(--c-mark-ink); background: color-mix(in srgb, var(--c-mark) 13%, transparent); }
  .st[data-s='shipped']  { color: var(--c-accent);   background: color-mix(in srgb, var(--c-accent) 11%, transparent); }
  .st[data-s='building'] { color: var(--c-muted);    border: 1px solid var(--c-border); }
  .st[data-s='archived'] { color: var(--c-muted);    background: var(--c-tinted); }
  .top time { color: var(--c-muted); }

  h2 { margin-block: var(--s-s) 0; font-family: var(--f-serif);
       font-variation-settings: var(--axis-display); font-weight: 400;
       font-size: var(--t-md); line-height: var(--lh-snug); }
  .what { margin-block-start: var(--s-2xs); font-family: var(--f-sans);
          font-size: var(--t-sm); color: var(--c-muted); line-height: 1.5; }

  /* Ölçülebilir sonuç — projeyi "yaptım" demekten ayıran şey. */
  /* Her ölçüm kendi hücresinde; dt/dd sarmalanmazsa ızgara onları
     ayrı hücrelere dağıtıyor ve değerler birbirine giriyor. */
  .m > div { display: grid; gap: .2em; align-content: start; }
  .m {
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr;
    gap: var(--s-s); margin-block-start: var(--s-m);
    padding-block-start: var(--s-s); border-block-start: 1px solid var(--c-border);
  }
  .m dt { font-family: var(--f-serif); font-variation-settings: var(--axis-display);
          font-size: var(--t-md); line-height: 1; font-variant-numeric: tabular-nums; }
  .m dd { margin: 0; font-family: var(--f-sans);
          font-size: var(--t-xs); color: var(--c-muted); }

  .stack { display: flex; flex-wrap: wrap; gap: .3em; margin-block-start: var(--s-s); }
  .stack code {
    font-family: var(--f-mono); font-size: var(--t-xs);
    padding: .15em .5em; border-radius: var(--radius-sm);
    background: var(--c-tinted); color: var(--c-muted);
  }
  @media (max-width: 34rem) { .m { grid-auto-flow: row; gap: var(--s-2xs); } }
</style>
