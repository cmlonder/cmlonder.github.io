---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { RADAR, RADAR_SERIES, type Locale } from '../../config';
import { formatDate, localePath } from '../../lib/content';
import AiMark from '../../components/AiMark.astro';

/* Radar içeriğini Spark Türkçe üretiyor, o yüzden bu sayfa İngilizce kökte
   dursa da Türkçe. Menüdeki tanıtım bunu İngilizce okura söylüyor. */
const lang: Locale = 'tr';

const all = (await getCollection('radar'))
  .filter((e) => !e.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const series = Object.entries(RADAR_SERIES)
  .map(([id, meta]) => ({ id, meta, entries: all.filter((e) => e.id.startsWith(`${id}/`)) }))
  .filter((s) => s.entries.length > 0);
---

<Base title={`${RADAR.name[lang]} — Cemal Önder`} description={RADAR.blurb[lang]} lang={lang}
      ogImage="/og/radar.png">
  <div class="wrap">
    <header class="head">
      <p class="kicker"><span class="count">{all.length}</span><a href="/">Ana sayfa</a></p>
      <h1>{RADAR.name[lang]}</h1>
      <p class="lead">
        Farklı sektör ve alanlardaki gelişmeleri, kurduğum veri akışları ve özel
        editoryal kurallarla düzenli bültenlere dönüştürüyorum. Bu sayfada yer alan
        tüm içerikler, çeşitli güvenilir kaynaklardan toplanarak yapay zekâ ajanları
        aracılığıyla derlenmiş özetlerden oluşur. Sitedeki yapay zekâ üretimi içeriklerin tamamı
        her zaman <AiMark level="generated" lang={lang} />{' '}
        etiketini taşır. Bu çalışma yöntemini ve benimsediğim ilkeleri{' '}
        <a href={localePath(lang, 'ai')}>yapay zeka kullanımı</a> sayfasında detaylarıyla anlattım.
      </p>
    </header>

    {series.map((s) => (
      <section class="series">
        <h2><a href={`/radar/${s.id}`}>{s.meta.name}</a></h2>
        <p class="sblurb">{s.meta.blurb}</p>
        <p class="stats meta">{s.entries.length} bülten</p>
        <ul class="list">
          {s.entries.slice(0, 5).map((e) => {
            return (
              <li>
                <a href={`/radar/${e.id}`}>{formatDate(e.data.date, lang)}</a>
                <span class="meta">{e.data.summary}</span>
              </li>
            );
          })}
        </ul>
        {s.entries.length > 5 && (
          <p class="more meta"><a href={`/radar/${s.id}`}>tümü ({s.entries.length}) →</a></p>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .list .meta {
    color: var(--c-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 34rem) {
    .list li { grid-template-columns: 1fr; gap: var(--s-3xs); }
  }

  .head { margin-block-end: var(--s-2xl); }
  .kicker {
    display: flex; align-items: baseline; gap: var(--s-2xs);
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark-ink); font-variant-numeric: tabular-nums; }
  .kicker a { text-decoration: none; }
  h1 {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-3xl);
    line-height: var(--lh-tight); letter-spacing: -0.02em;
  }
  .blurb {
    margin-block-start: var(--s-2xs); max-inline-size: 38ch;
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-size: var(--t-lg); line-height: 1.25; color: var(--c-muted);
  }
  .lead {
    margin-block-start: var(--s-s); max-inline-size: 62ch;
    font-family: var(--f-sans); font-size: var(--t-sm); line-height: 1.55;
  }
  .lead a, .feed a, .more a { color: var(--c-accent); }
  .feed { margin-block-start: var(--s-2xs); }

  .series { padding-block-start: var(--s-s); border-block-start: 1px solid var(--c-border); max-inline-size: 66ch; }
  .series + .series { margin-block-start: var(--s-m); }
  .series h2 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-md); line-height: var(--lh-snug);
  }
  .series h2 a { text-decoration: none; }
  .series h2 a:hover { color: var(--c-accent); }
  .sblurb {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-sans); font-size: var(--t-sm); color: var(--c-muted);
  }
  .stats { margin-block-start: var(--s-3xs); }
  .stats .bad { color: var(--c-accent); }

  .list { list-style: none; padding: 0; margin-block-start: var(--s-2xs); display: grid; }
  .list li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--s-xs);
    align-items: baseline;
    padding-block: var(--s-2xs);
    border-block-start: 1px solid var(--c-border);
  }
  .list li + li { border-block-start: 1px solid var(--c-border); }
  .list a { text-decoration: none; }
  .list [data-clean='false'] { color: var(--c-accent); }
  .list [data-clean='true'] { color: var(--c-mark-ink); }
  .more { margin-block-start: var(--s-2xs); }
</style>
