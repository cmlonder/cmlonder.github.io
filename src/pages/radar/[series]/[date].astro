---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { RADAR, RADAR_SERIES, SITE, type Locale } from '../../../config';
import { formatDate } from '../../../lib/content';

export async function getStaticPaths() {
  const all = (await getCollection('radar'))
    .filter((e) => !e.data.draft || import.meta.env.DEV);

  return all.map((entry) => {
    const [series, date] = entry.id.split('/');
    // Aynı serinin bültenleri tarih sırasında; komşuları burada bul,
    // sayfada gezinme bağlantısı olarak kullan.
    const sibs = all
      .filter((e) => e.id.startsWith(`${series}/`))
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
    const i = sibs.findIndex((e) => e.id === entry.id);
    return {
      params: { series, date },
      props: { entry, series, prev: sibs[i - 1] ?? null, next: sibs[i + 1] ?? null },
    };
  });
}

// Kapak konvansiyonla bulunuyor: src/assets/radar/<seri>-<tarih>.png
// Frontmatter'a "image:" yazdırmıyoruz — Spark'ın dosyasına dokunmamak
// için. Dosya varsa kapak var, yoksa yok.
const kapaklar = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/radar/*.{png,jpg,jpeg,webp}', { eager: true });

const lang: Locale = 'tr';
const { entry, series, prev, next } = Astro.props;
const kapakYolu = Object.keys(kapaklar).find((k) =>
  k.includes(`/${series}-${entry.id.split('/')[1]}.`));
const kapak = kapakYolu ? kapaklar[kapakYolu].default : null;
const meta = RADAR_SERIES[series as keyof typeof RADAR_SERIES];
const { Content } = await render(entry);

---

<Base title={`${entry.data.title} — ${RADAR.name.tr}`} description={entry.data.summary}
      lang={lang} ogImage="/og/radar.png">
  <article class="narrow">
    <header>
      <p class="kicker meta">
        <a href="/radar">{RADAR.name.tr}</a>
        <span aria-hidden="true">/</span>
        <a href={`/radar/${series}`}>{meta?.name ?? series}</a>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.summary}</p>
    </header>

    {kapak && (
      <Image class="cover" src={kapak} alt="" widths={[640, 960, 1280]}
             sizes="(max-width: 46rem) 100vw, 46rem" loading="eager" />
    )}

    <div class="prose"><Content /></div>
    <nav class="daynav" aria-label="Diğer bültenler">
      {prev ? (
        <a class="prev" href={`/radar/${prev.id}`}>
          <span class="dir">← Önceki</span>
          <span class="day">{formatDate(prev.data.date, lang)}</span>
        </a>
      ) : <span />}
      {next && (
        <a class="next" href={`/radar/${next.id}`}>
          <span class="dir">Sonraki →</span>
          <span class="day">{formatDate(next.data.date, lang)}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  inLanguage: 'tr',
  isPartOf: { '@type': 'CreativeWorkSeries', name: meta?.name ?? series },
  url: new URL(`/radar/${entry.id}`, SITE.url).href,
  digitalSourceType: 'http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia',
  creativeWorkStatus: 'Machine-generated, machine-audited',
  creator: { '@type': 'SoftwareApplication', name: entry.data.generator },
  editor: { '@type': 'Person', name: SITE.author, url: SITE.url },
})} is:inline />

<style>
  .daynav {
    display: flex;
    justify-content: space-between;
    gap: var(--s-s);
    margin-block-start: var(--s-2xl);
    padding-block-start: var(--s-s);
    border-block-start: 1px solid var(--c-border);
    font-family: var(--f-sans);
  }
  .daynav a {
    display: grid;
    gap: .15em;
    text-decoration: none;
    min-block-size: 44px;
  }
  .daynav .next { text-align: end; }
  .daynav .dir { font-size: var(--t-sm); color: var(--c-accent); }
  .daynav .day { font-size: var(--t-xs); color: var(--c-muted); }
  .daynav a:hover .day { color: var(--c-text); }

  .cover {
    display: block;
    inline-size: 100%;
    block-size: auto;
    margin-block: var(--s-l) var(--s-xl);
    border-radius: var(--radius);
    background: var(--c-tinted);
  }

  .kicker {
    display: flex; flex-wrap: wrap; gap: var(--s-3xs);
    text-transform: uppercase; letter-spacing: .08em;
    margin-block-end: var(--s-2xs);
  }
  .kicker a { text-decoration: none; color: var(--c-accent); font-weight: 700; }
  h1 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-2xl);
    line-height: var(--lh-tight); text-wrap: balance;
  }
  .standfirst {
    margin-block: var(--s-2xs) var(--s-s);
    color: var(--c-muted); font-style: italic;
    font-size: 1.0625rem; text-wrap: pretty;
  }
  .note { margin-block-start: var(--s-3xs); max-inline-size: 60ch; }
  .audit { margin-block-start: var(--s-xl); padding-block-start: var(--s-s); border-block-start: 1px solid var(--c-border); }
  .prompt { margin-block-start: var(--s-m); }
  .prompt code { font-family: var(--f-mono); }
</style>
