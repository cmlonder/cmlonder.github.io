---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Sources from '../../../components/Sources.astro';
import { RADAR, RADAR_SERIES, SITE, type Locale } from '../../../config';
import { formatDate } from '../../../lib/content';
import verification from '../../../data/radar-verification.json';

export async function getStaticPaths() {
  const all = await getCollection('radar');
  return all
    .filter((e) => !e.data.draft || import.meta.env.DEV)
    .map((entry) => {
      const [series, date] = entry.id.split('/');
      return { params: { series, date }, props: { entry, series } };
    });
}

const lang: Locale = 'tr';
const { entry, series } = Astro.props;
const meta = RADAR_SERIES[series as keyof typeof RADAR_SERIES];
const { Content } = await render(entry);

const v = (verification as Record<string, any>)[entry.id];
const stats = v ?? { total: entry.data.claims.length, passed: 0, failed: 0, inconclusive: 0, unsourced: 0, staleCount: 0, checkedAt: '—' };
const claims = v?.claims ?? entry.data.claims.map((c: any) => ({ ...c, verdict: 'ERISILDI' }));
---

<Base title={`${entry.data.title} — ${RADAR.name.tr}`} description={entry.data.summary}
      lang={lang} ogImage="/og/radar.png">
  <article class="narrow">
    <header>
      <p class="kicker meta">
        <a href="/radar">{RADAR.name.tr}</a>
        <span aria-hidden="true">/</span>
        <a href={`/radar/${series}`}>{meta?.name ?? series}</a>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.summary}</p>
    </header>

    {v?.cover && <div class="cover" set:html={v.cover} />}

    <div class="prose"><Content /></div>
    <Sources claims={claims} checkedAt={stats.checkedAt} />

    <p class="prompt meta">
      <a href={`/radar/${series}`}>{meta?.name ?? series}</a> ·
      {entry.data.generator} · <code>{entry.data.promptVersion}</code>
    </p>
  </article>
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  inLanguage: 'tr',
  isPartOf: { '@type': 'CreativeWorkSeries', name: meta?.name ?? series },
  url: new URL(`/radar/${entry.id}`, SITE.url).href,
  digitalSourceType: 'http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia',
  creativeWorkStatus: 'Machine-generated, machine-audited',
  creator: { '@type': 'SoftwareApplication', name: entry.data.generator },
  editor: { '@type': 'Person', name: SITE.author, url: SITE.url },
})} is:inline />

<style>
  /* Kapak: verify-radar.mjs'in ürettiği deterministik SVG.
     Doğrulanmış grafik verisi varsa o günün rakamlarını gösterir,
     yoksa tarih ve doğrulama oranıyla sade bir kapak. */
  .cover {
    margin-block: var(--s-l) var(--s-xl);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    overflow: hidden;
    aspect-ratio: 1200 / 420;
  }
  .cover :global(.cv) { display: block; inline-size: 100%; block-size: 100%; }
  .cover :global(.cv-kick) {
    font-family: var(--f-sans); font-size: 21px;
    letter-spacing: .14em; text-transform: uppercase; fill: var(--c-muted);
  }
  .cover :global(.cv-rule) { stroke: var(--c-border); stroke-width: 1.5; }
  .cover :global(.cv-big)  {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-size: 104px; font-weight: 600; fill: var(--c-text);
  }
  .cover :global(.cv-to)   { fill: var(--c-accent); }
  .cover :global(.cv-arr)  { font-family: var(--f-sans); font-size: 56px; fill: var(--c-muted); }
  .cover :global(.cv-pct)  { font-family: var(--f-sans); font-size: 40px; font-weight: 700; fill: var(--c-accent); }
  .cover :global(.cv-ln)   { fill: none; stroke: var(--c-accent); stroke-width: 2.5;
                             stroke-linecap: round; stroke-linejoin: round; }
  .cover :global(.cv-d)    { fill: var(--c-accent); }
  .cover :global(.cv-tk)   { font-family: var(--f-sans); font-size: 20px; fill: var(--c-muted); }
  .cover :global(.cv-m)    { fill: var(--c-accent); }
  .cover :global(.cv-mo)   { fill: none; stroke: var(--c-border); stroke-width: 2; }

  .kicker {
    display: flex; flex-wrap: wrap; gap: var(--s-3xs);
    text-transform: uppercase; letter-spacing: .08em;
    margin-block-end: var(--s-2xs);
  }
  .kicker a { text-decoration: none; color: var(--c-accent); font-weight: 700; }
  h1 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-2xl);
    line-height: var(--lh-tight); text-wrap: balance;
  }
  .standfirst {
    margin-block: var(--s-2xs) var(--s-s);
    color: var(--c-muted); font-style: italic;
    font-size: 1.0625rem; text-wrap: pretty;
  }
  .note { margin-block-start: var(--s-3xs); max-inline-size: 60ch; }
  .audit { margin-block-start: var(--s-xl); padding-block-start: var(--s-s); border-block-start: 1px solid var(--c-border); }
  .prompt { margin-block-start: var(--s-m); }
  .prompt code { font-family: var(--f-mono); }
</style>
