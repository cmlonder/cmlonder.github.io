---
import OnePage from '../../../layouts/OnePage.astro';
import { getDomains, getChapters } from '../../../lib/content';
import type { Locale } from '../../../config';

export async function getStaticPaths() {
  const domains = await getDomains('en');
  const chapters = await getChapters('en');

  return domains.map((dm) => {
    const slug = dm.id.split('/').pop()!;
    const yazilan = new Map(
      chapters.filter((c) => c.data.domain === slug).map((c) => [c.id.split('/').pop()!, c]));
    return {
      params: { domain: slug },
      props: {
        dm,
        // Kitap sırası içindekilerden gelir.
        bolumler: dm.data.outline
          .filter((b) => yazilan.has(b.slug))
          .map((b) => ({
            slug: b.slug,
            no: dm.data.outline.findIndex((x) => x.slug === b.slug) + 1,
            entry: yazilan.get(b.slug)!,
          })),
        toplam: dm.data.outline.length,
      },
    };
  });
}

const lang: Locale = 'en';
---

<OnePage lang={lang} {...Astro.props} />
