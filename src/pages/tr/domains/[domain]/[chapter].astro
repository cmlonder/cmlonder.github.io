---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Outline from '../../../../components/Outline.astro';
import { DOMAINS, DOMAIN_UI, ORIGIN_UI, type Locale } from '../../../../config';
import { localePath, formatDate, getDomains, getChapters } from '../../../../lib/content';

export async function getStaticPaths() {
  const domains = await getDomains('tr');
  const chapters = await getChapters('tr');

  return domains.flatMap((dm) => {
    const slug = dm.id.split('/').pop()!;
    const yazilan = new Map(
      chapters.filter((c) => c.data.domain === slug).map((c) => [c.id.split('/').pop()!, c]));
    // Sıra İÇİNDEKİLERDEN gelir, tarihten değil — kitap sırası budur.
    const sirali = dm.data.outline.filter((b) => yazilan.has(b.slug));

    return sirali.map((b, i) => ({
      params: { domain: slug, chapter: b.slug },
      props: {
        dm, entry: yazilan.get(b.slug)!,
        no: dm.data.outline.findIndex((x) => x.slug === b.slug) + 1,
        toplam: dm.data.outline.length,
        onceki: sirali[i - 1] ?? null,
        sonraki: sirali[i + 1] ?? null,
        // Yazılmamış bir sonraki bölüm varsa onun sözünü göster.
        sozVerilen: dm.data.outline[dm.data.outline.findIndex((x) => x.slug === b.slug) + 1] ?? null,
        yazilan,
      },
    }));
  });
}

const lang: Locale = 'tr';
const { dm, entry, no, toplam, onceki, sonraki, sozVerilen, yazilan } = Astro.props;
const dSlug = dm.id.split('/').pop()!;
const t = DOMAIN_UI[lang];
const { Content } = await render(entry);
const capraz = entry.data.crossRef;

// Makine kaynağı künyesi: araç ve tür yerine konur, gövdeden önce görünür.
const koken = entry.data.origin
  ? ORIGIN_UI[lang].chapter
      .replace('{tool}', entry.data.origin.tool)
      .replace('{kind}', entry.data.origin.kind)
  : null;
---

<Base title={`${entry.data.title} — ${dm.data.title}`} description={entry.data.summary} lang={lang}>
  <div class="book" data-reading data-toc="acik" data-notes="acik">
    <aside class="rail toc-rail" data-rail="toc">
      <div class="ray-ic">
      <a class="up" href={localePath(lang, DOMAINS.path, dSlug)}>{dm.data.title}</a>
      <Outline outline={dm.data.outline} yazilan={yazilan} domain={dSlug}
               lang={lang} aktif={entry.id.split('/').pop()} compact />
      <a class="one" href={localePath(lang, DOMAINS.path, dSlug, 'read')}>{t.onePage} &#8594;</a>
      </div>
    </aside>

    <article class="chapter">
      <div class="ray-tut sol">
        <button type="button" class="ray-ok" data-toggle="toc" aria-expanded="true"
                aria-label={t.contents} title={t.contents}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
               stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
      </div>
      <div class="ray-tut sag">
        <button type="button" class="ray-ok" data-toggle="notes" aria-expanded="true"
                aria-label={t.notes} title={t.notes}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
               stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
      </div>

      <p class="kicker">
        <a href={localePath(lang, DOMAINS.path, dSlug)}>{dm.data.title}</a>
        <span aria-hidden="true">·</span>
        <span>{t.chapter} {no} {t.of} {toplam}</span>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="standfirst">{entry.data.summary}</p>
      <p class="meta"><time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, lang)}</time></p>

      {koken && (
        <p class="origin">
          {koken}
          {entry.data.origin?.note && <span> {entry.data.origin.note}</span>}
        </p>
      )}

      <div class="prose"><Content /></div>

      {capraz && (
        <aside class="cross">
          <p class="lbl">{t.crossRef}</p>
          <a href={localePath(lang, DOMAINS.path, capraz.domain, capraz.slug)}>{capraz.why}</a>
        </aside>
      )}

      <nav class="chapnav">
        {onceki
          ? <a class="prev" href={localePath(lang, DOMAINS.path, dSlug, onceki.slug)}>
              <span class="dir">&#8592;</span><span class="ttl">{onceki.title}</span>
            </a>
          : <span />}
        {sonraki
          ? <a class="next" href={localePath(lang, DOMAINS.path, dSlug, sonraki.slug)}>
              <span class="dir">{t.nextUp} &#8594;</span><span class="ttl">{sonraki.title}</span>
            </a>
          : sozVerilen && (
            <span class="next soon">
              <span class="dir">{t.nextUp}</span>
              <span class="ttl">{sozVerilen.title}</span>
              <span class="soonlbl">{t.notYet}</span>
            </span>
          )}
      </nav>
    </article>

    <aside class="rail notes-rail" data-rail="notes" aria-label={t.notes}>
      <div class="ray-ic"></div>
    </aside>
  </div>
</Base>

<script>
  // Kenar notlarını sağ raya taşıyan ve rayları açıp kapatan kod.
  // Bölüm sayfalarında bir ara düşmüştü: raylar çiziliyor ama okların
  // altında hiçbir şey yoktu, tıklamak işe yaramıyordu.
  import './../../../../scripts/reading';
</script>

<style>
  .origin {
    margin-block-start: var(--s-m); padding: var(--s-s);
    border-inline-start: 2px solid var(--c-border); background: var(--c-tinted);
    font-family: var(--f-sans); font-size: var(--t-xs);
    color: var(--c-muted-on-tint); line-height: 1.5; text-wrap: pretty;
  }

  .book {
    inline-size: min(100% - var(--s-l), calc(var(--ray-toc, 15rem) + var(--w-narrow) + var(--ray-not, 15rem)));
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--ray-toc, 15rem) minmax(0, var(--w-narrow)) var(--ray-not, 15rem);
    column-gap: 0;
    justify-content: center;
    align-items: start;
  }
  .rail { position: sticky; inset-block-start: var(--s-l); }
  .toc-rail   { padding-inline-end: var(--s-2xl); }
  .notes-rail { padding-inline-start: var(--s-2xl); }
  .chapter { position: relative; }
  /* Kapalı ray tamamen gidiyor; ok yazının kenarında, yerinde kalıyor. */
  .book[data-toc='kapali']   { --ray-toc: 0rem; }
  .book[data-notes='kapali'] { --ray-not: 0rem; }
  .book[data-toc='kapali']   > .toc-rail,
  .book[data-notes='kapali'] > .notes-rail { display: none; }
  .up {
    display: block; font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em;
    color: var(--c-accent); text-decoration: none;
    padding-block-end: var(--s-2xs);
    margin-block-end: var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
  .one {
    display: inline-block; margin-block-start: var(--s-m);
    font-family: var(--f-sans); font-size: var(--t-xs); color: var(--c-muted);
  }
  .one:hover { color: var(--c-accent); }

  .kicker {
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
    display: flex; gap: .55em; flex-wrap: wrap;
  }
  .kicker a { color: var(--c-accent); text-decoration: none; }
  h1 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; line-height: var(--lh-tight); margin-block-start: var(--s-2xs);
  }
  .standfirst {
    margin-block-start: var(--s-s); font-family: var(--f-serif);
    font-size: var(--t-md); color: var(--c-muted); line-height: 1.35; text-wrap: balance;
  }
  .meta { margin-block-start: var(--s-2xs); font-family: var(--f-sans);
          font-size: var(--t-xs); color: var(--c-muted); }
  .prose { margin-block-start: var(--s-l); }

  /* Çapraz gönderme — domainler arası örüntü, bu yapının asıl iddiası. */
  .cross {
    margin-block-start: var(--s-xl);
    padding: var(--s-s) var(--s-m);
    border-inline-start: 2px solid var(--c-mark);
    background: color-mix(in srgb, var(--c-mark) 7%, transparent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .cross .lbl {
    font-family: var(--f-sans); font-size: var(--t-xs);
    /* Tonlu zeminde: --c-muted burada 3.86:1'e düşüyordu. */
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted-on-tint);
    margin-block-end: .3em;
  }
  .cross a { font-family: var(--f-serif); font-size: var(--t-sm); }

  .chapnav {
    display: flex; justify-content: space-between; gap: var(--s-s);
    margin-block-start: var(--s-2xl); padding-block-start: var(--s-s);
    border-block-start: 1px solid var(--c-border); font-family: var(--f-sans);
  }
  .chapnav a, .chapnav .soon { display: grid; gap: .15em; text-decoration: none; max-inline-size: 20ch; }
  .chapnav .next { text-align: end; }
  .chapnav .dir { font-size: var(--t-sm); color: var(--c-accent); }
  .chapnav .ttl { font-size: var(--t-xs); color: var(--c-muted); }
  .chapnav a:hover .ttl { color: var(--c-text); }
  /* Sıradaki bölüm henüz yazılmadıysa da gösteriliyor — söz açıkta duruyor. */
  .chapnav .soon .dir { color: var(--c-muted); }
  /* opacity .8 bunu 3.13:1'e düşürüyordu. Solgunluk italikle taşınıyor. */
  .chapnav .soonlbl {
    font-size: var(--t-xs); font-style: italic; color: var(--c-muted);
  }

  @media (max-width: 62rem) {
    .book { grid-template-columns: minmax(0, var(--w-narrow)); }
    .book > .notes-rail { display: none; }
    .rail { display: none; }
    .ray-tut { display: none; }
  }
</style>
