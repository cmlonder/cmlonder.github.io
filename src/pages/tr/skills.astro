---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SKILLS, type Locale, PAGE } from '../../config';
import { localePath } from '../../lib/content';

const lang: Locale = 'tr';
const other = 'en' as const;

const skills = (await getCollection('skills')).sort((a, b) => a.id.localeCompare(b.id));
const rendered = await Promise.all(skills.map(async (s) => ({ s, ...(await render(s)) })));

const back = PAGE[lang].back;
const t = PAGE[lang];
---

<Base title={`${SKILLS.name[lang]} — Cemal Önder`} description={SKILLS.blurb[lang]}
      lang={lang} altLocale={{ lang: other, href: localePath(other, 'skills') }}>
  <div class="wrap manifest">
    <header class="head">
      <p class="kicker"><span class="count">{skills.length}</span><a href={localePath(lang, '')}>{back}</a></p>
      <h1>{SKILLS.name[lang]}</h1>
      <p class="blurb">{SKILLS.blurb[lang]}</p>
      <p class="lead">{t.skillsLead}</p>
    </header>

    {rendered.map(({ s, Content }) => (
      <section class="skill" id={s.data.name}>
        <h2>{s.data.name}</h2>
        <p class="desc">{s.data.description}</p>
        <dl class="facts meta">
          <dt>{t.repoPath}</dt>
          <dd><code>.claude/skills/{s.id.split('/')[0]}/SKILL.md</code></dd>
          {s.data['allowed-tools'] && (<><dt>{t.tools}</dt><dd><code>{s.data['allowed-tools']}</code></dd></>)}
        </dl>
        <details>
          <summary>{t.showFile}</summary>
          <div class="prose"><Content /></div>
        </details>
      </section>
    ))}
  </div>
</Base>

<style>
  /*
   * Skill'ler makine için yazılmış talimatlar; sayfa da onu söylemeli.
   * Her skill bir manifest bloğu: mono başlık, kopyalanabilir gövde,
   * dosya yolu künyesi. Süs değil — içeriğin ne olduğunun işareti.
   */
  .manifest :global(article) {
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    padding: var(--s-m);
    margin-block-end: var(--s-m);
  }
  .manifest :global(article > h2) {
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    font-weight: 400;
    letter-spacing: 0;
  }
  .manifest :global(article > h2::before) {
    content: '.claude/skills/';
    color: var(--c-muted);
  }

  .head { margin-block-end: var(--s-2xl); }
  .kicker {
    display: flex; align-items: baseline; gap: var(--s-2xs);
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark-ink); font-variant-numeric: tabular-nums; }
  .kicker a { text-decoration: none; }
  h1 {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-3xl);
    line-height: var(--lh-tight); letter-spacing: -0.02em;
  }
  .blurb {
    margin-block-start: var(--s-2xs); max-inline-size: 38ch;
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-size: var(--t-lg); line-height: 1.25; color: var(--c-muted);
  }
  .lead {
    margin-block-start: var(--s-s); max-inline-size: 60ch;
    font-family: var(--f-sans); font-size: var(--t-sm); line-height: 1.55;
  }

  .skill {
    padding-block: var(--s-m);
    border-block-start: 1px solid var(--c-border);
    max-inline-size: 66ch;
  }
  .skill h2 {
    font-family: var(--f-mono); font-size: var(--t-base);
    font-weight: 400; color: var(--c-accent);
  }
  .desc {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-sans); font-size: var(--t-sm);
    line-height: 1.55; color: var(--c-muted);
  }
  .facts {
    margin-block-start: var(--s-2xs);
    display: grid; grid-template-columns: auto 1fr; gap: 2px var(--s-2xs);
  }
  .facts dt { text-transform: uppercase; letter-spacing: .06em; }
  .facts code { font-family: var(--f-mono); font-size: .95em; }
  details { margin-block-start: var(--s-2xs); }
  summary {
    cursor: pointer; font-family: var(--f-sans);
    font-size: var(--t-xs); color: var(--c-accent);
  }
  details[open] summary { margin-block-end: var(--s-2xs); }
  details .prose { font-size: var(--t-sm); }
</style>
