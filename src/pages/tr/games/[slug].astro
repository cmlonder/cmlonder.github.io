---
import { getCollection } from 'astro:content';
import ShelfEntry from '../../../layouts/ShelfEntry.astro';
import { type Locale } from '../../../config';

export async function getStaticPaths() {
  const all = await getCollection('games');
  const kendi = all.filter((e) => e.id.startsWith('tr/'));
  const yedek = all.filter((e) => e.id.startsWith('tr/')).length ? 'tr/' : 'en/';
  const liste = (kendi.length ? kendi : all.filter((e) => e.id.startsWith(yedek)))
    .sort((a, b) => a.data.order - b.data.order);

  return liste.map((entry, i) => ({
    params: { slug: entry.id.split('/').pop()! },
    props: { entry, shown: entry.id.split('/')[0] as Locale, prev: liste[i - 1] ?? null, next: liste[i + 1] ?? null },
  }));
}

const lang: Locale = 'tr';
const { entry, shown, prev, next } = Astro.props;
---

<ShelfEntry entry={entry} shown={shown} shelf="games" lang={lang} prev={prev} next={next} />
