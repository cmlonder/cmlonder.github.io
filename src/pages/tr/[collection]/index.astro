---
import ListPage from '../../../layouts/ListPage.astro';
import SignalStream from '../../../layouts/SignalStream.astro';
import EssayList from '../../../components/EssayList.astro';
import NoteGarden from '../../../components/NoteGarden.astro';
import PlaybookList from '../../../components/PlaybookList.astro';
import { COLLECTIONS, COLLECTION_LABELS, COLLECTION_BLURBS, type Locale } from '../../../config';
import { getEntries, localePath } from '../../../lib/content';

export async function getStaticPaths() {
  return COLLECTIONS.map((collection) => ({ params: { collection } }));
}

const lang: Locale = 'tr';
const { collection } = Astro.params as { collection: typeof COLLECTIONS[number] };

const entries = await getEntries(collection, lang);
const items = entries.map((entry) => ({ collection, entry }));

const enEntries = await getEntries(collection, 'en');
const altLocale = enEntries.length
  ? { lang: 'en' as const, href: localePath('en', collection) }
  : null;

// Her koleksiyonun kendi gövdesi var; ayrım tasarımda da görünsün diye.
const Govde = collection === 'essays' ? EssayList
  : collection === 'notes' ? NoteGarden
  : collection === 'playbooks' ? PlaybookList
  : null;

const action = collection === 'playbooks'
  ? { label: 'Hangi playbook? Belirtiden bul', href: localePath(lang, 'playbooks/find') }
  : null;
---

{collection === 'signals' ? (
  <SignalStream
    title={COLLECTION_LABELS[collection][lang]}
    blurb={COLLECTION_BLURBS[collection][lang]}
    lang={lang}
    items={entries}
    altLocale={altLocale}
  />
) : (
<ListPage
  action={action}
  title={COLLECTION_LABELS[collection][lang]}
  blurb={COLLECTION_BLURBS[collection][lang]}
  lang={lang}
  items={items}
  altLocale={altLocale}
>
  {Govde && <Govde entries={entries} lang={lang} />}
</ListPage>
)}
