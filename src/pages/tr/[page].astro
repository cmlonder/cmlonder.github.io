---
import { getCollection, getEntry, render } from 'astro:content';
import type { Locale } from '../../config';
import Contact from '../../components/Contact.astro';
import Base from '../../layouts/Base.astro';
import { localePath, formatDate } from '../../lib/content';
import { PAGE } from '../../config';

export async function getStaticPaths() {
  const all = await getCollection('site');
  return all
    .filter((e) => e.id.startsWith('tr/'))
    .map((e) => ({ params: { page: e.id.split('/')[1] }, props: { entry: e } }));
}

const lang: Locale = 'tr';
const other = 'en' as const;
const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.split('/')[1];
const twin = await getEntry('site', `${other}/${slug}`);
const altLocale = twin
  ? { lang: other, href: localePath(other, slug) }
  : null;

const updatedLabel = PAGE[lang].updated;
---

<Base title={`${entry.data.title} — Cemal Önder`} description={entry.data.description}
      lang={lang} altLocale={altLocale}>
  <article class="narrow">
    <h1>{entry.data.title}</h1>
    <p class="meta">{updatedLabel} {formatDate(entry.data.updated, lang)}</p>
    <div class:list={['prose', slug === 'now' && 'timeline', slug === 'uses' && 'spec']}><Content /></div>
    {slug === 'about' && <Contact lang={lang} />}
  </article>
</Base>

<style>
  h1 {
    font-family: var(--f-serif);
    font-variation-settings: var(--axis-display);
    font-weight: 400;
    font-size: var(--t-2xl);
    line-height: var(--lh-tight);
  }
  .meta { margin-block-start: var(--s-3xs); }
  .prose { margin-block-start: var(--s-l); }

  /*
   * /uses bir envanter, deneme yazısı değil. Bölüm başlıkları sol
   * sütunda etiket gibi duruyor, içerik sağda — teknik bir föy gibi
   * okunuyor. Dar ekranda normal akışa dönüyor.
   */
  .spec :global(h2) {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--c-muted);
    margin-block: var(--s-2xl) var(--s-s);
    padding-block-end: var(--s-2xs);
    border-block-end: 1px solid var(--c-border);
  }
  .spec :global(h2:first-of-type) { margin-block-start: var(--s-l); }
  .spec :global(h3) {
    font-family: var(--f-sans);
    font-size: var(--t-sm);
    font-weight: 600;
    margin-block: var(--s-m) var(--s-3xs);
  }
  /* Liste kalemleri bir donanım föyü gibi: etiket solda, açıklama sağda. */
  .spec :global(ul) { list-style: none; padding: 0; }
  .spec :global(ul > li) {
    padding-block: var(--s-2xs);
    border-block-start: 1px solid var(--c-border);
  }
  .spec :global(ul > li > strong:first-child),
  .spec :global(ul > li > code:first-child) {
    display: inline-block;
    min-inline-size: 12rem;
    margin-inline-end: var(--s-2xs);
  }
  @media (max-width: 40rem) {
    .spec :global(ul > li > strong:first-child),
    .spec :global(ul > li > code:first-child) { min-inline-size: 0; display: block; }
  }

  /*
   * /now bir "şu an ne yapıyorum" sayfası değil, bir DİKKAT ARŞİVİ:
   * her güncelleme öncekini silmiyor, üstüne ekleniyor. Ay başlıkları
   * dikey bir rayın üzerinde işaretçiye dönüşüyor.
   */
  .timeline { position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    /* Ray ilk işaretçiden başlasın; giriş paragrafının yanından
       inen çizgi, olmayan bir geçmişi ima ediyordu. */
    inset-block: var(--s-3xl) 0;
    inset-inline-start: 0;
    inline-size: 1px;
    background: var(--c-border);
  }
  .timeline :global(> *) { margin-inline-start: var(--s-xl); }
  /* Giriş paragrafı bir günlük girdisi değil; raya hizalanmasın. */
  .timeline :global(> p:first-child) {
    margin-inline-start: 0;
    margin-block-end: var(--s-xl);
  }
  .timeline :global(h2) {
    position: relative;
    margin-block: var(--s-2xl) var(--s-s);
    font-family: var(--f-sans);
    font-size: var(--t-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--c-muted);
  }
  .timeline :global(h2::before) {
    content: '';
    position: absolute;
    inset-inline-start: calc(-1 * var(--s-xl));
    inset-block-start: .35em;
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: var(--c-bg);
    border: 2px solid var(--c-border);
    transform: translateX(-4px);
  }
  /* En yeni ay vurgulu — okur nereye bakacağını bilsin. */
  .timeline :global(h2:first-of-type) { color: var(--c-accent); }
  .timeline :global(h2:first-of-type::before) {
    background: var(--c-accent);
    border-color: var(--c-accent);
  }
  .timeline :global(h3) {
    margin-block: var(--s-m) var(--s-2xs);
    font-size: var(--t-md);
  }
  .timeline :global(h2 + h3) { margin-block-start: 0; }
</style>
