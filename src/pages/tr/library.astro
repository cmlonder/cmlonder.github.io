---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import { LIBRARY, UI, type Locale, PAGE } from '../../config';
import { localePath } from '../../lib/content';

const lang: Locale = 'tr';
const other = 'en' as const;

const all = await getCollection('library');
const books = all
  .filter((b) => b.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);
// Türkçesi yoksa İngilizce listeyi göster — kitaplar dile bağlı değil.
const items = books.length ? books : all.filter((b) => b.id.startsWith('en/')).sort((a, b) => a.data.order - b.data.order);

const back = PAGE[lang].back;
---

<Base title={`${LIBRARY.name[lang]} — Cemal Önder`} description={LIBRARY.blurb[lang]}
      lang={lang} altLocale={{ lang: other, href: localePath(other, 'library') }}>
  <div class="wrap">
    <header class="head">
      <p class="kicker"><span class="count">{items.length}</span><a href={localePath(lang, '')}>{back}</a></p>
      <h1>{LIBRARY.name[lang]}</h1>
      <p class="blurb">{LIBRARY.blurb[lang]}</p>
    </header>

    {items.length === 0 ? <p class="meta">{UI[lang].empty}</p> : (
      <ul class="books">
        {items.map((entry) => <li><BookCard entry={entry} /></li>)}
      </ul>
    )}
  </div>
</Base>

<style>
  .head { margin-block-end: var(--s-2xl); }
  .kicker {
    display: flex; align-items: baseline; gap: var(--s-2xs);
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark); font-variant-numeric: tabular-nums; }
  .kicker a { text-decoration: none; }
  h1 {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-3xl);
    line-height: var(--lh-tight); letter-spacing: -0.02em;
  }
  .blurb {
    margin-block-start: var(--s-2xs); max-inline-size: 38ch;
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-size: var(--t-lg); line-height: 1.25; color: var(--c-muted);
  }
  .books {
    list-style: none; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--s-l) var(--s-m);
  }
</style>
