---
import Base from '../../../layouts/Base.astro';
import { getEntries, parseId, entryPath, localePath } from '../../../lib/content';

/**
 * Belirti seçici. Ağaç elle yazılmıyor — playbook'ların symptoms alanından
 * türetiliyor, yani yeni playbook eklenince seçenekler de kendiliğinden büyür.
 */
const lang = 'tr' as const;
const other = lang === 'en' ? 'tr' : 'en';

const entries = await getEntries('playbooks', lang);
const items = entries
  .map((e) => {
    const d = e.data as any;
    const slug = parseId(e.id).slug;
    return {
      href: entryPath(lang, 'playbooks', slug),
      title: d.title,
      description: d.description,
      problem: d.problem,
      context: d.context,
      symptoms: (d.symptoms ?? []) as string[],
      tryFirst: d.tryFirst ?? 50,
    };
  })
  .filter((i) => i.symptoms.length > 0)
  .sort((a, b) => a.tryFirst - b.tryFirst);

const counts = new Map<string, number>();
for (const i of items) for (const s of i.symptoms) counts.set(s, (counts.get(s) ?? 0) + 1);
const symptoms = [...counts.keys()].sort((a, b) => a.localeCompare(b, lang));

const t = {
  title: 'Hangi playbook?',
  blurb: 'Gördüğün belirtileri seç. Eşleşen playbook\'lar öne çıkar.',
  pick: 'Belirtiler', clear: 'Temizle', back: 'Tüm playbook\'lar',
  problem: 'Problem', context: 'Bağlam', match: 'eşleşme',
  none: 'Seçim yok — hepsi listeleniyor, en ucuz çözüm önce.',
  noMatch: 'Bu kombinasyona uyan playbook yok. Bir belirti çıkarmayı dene.',
};
---

<Base title={t.title + ' — Cemal Önder'} description={t.blurb} lang={lang}
      altLocale={{ lang: other as 'en' | 'tr', href: localePath(other as 'en' | 'tr', 'playbooks/find') }}>
  <div class="wrap">
    <header class="head">
      <p class="kicker">
        <span class="count">{items.length}</span>
        <a href={localePath(lang, 'playbooks')}>{t.back}</a>
      </p>
      <h1>{t.title}</h1>
      <p class="blurb">{t.blurb}</p>
    </header>

    <fieldset class="picker">
      <legend class="section-title">{t.pick}</legend>
      <div class="chips">
        {symptoms.map((s) => (
          <label class="chip">
            <input type="checkbox" value={s} />
            <span>{s}</span>
            <small>{counts.get(s)}</small>
          </label>
        ))}
      </div>
      <button type="button" id="clear">{t.clear}</button>
    </fieldset>

    <p class="status meta" id="status"
       data-none={t.none} data-match={t.match} data-nomatch={t.noMatch}>{t.none}</p>

    <ul class="results" id="results">
      {items.map((i) => (
        <li data-symptoms={JSON.stringify(i.symptoms)} data-try={i.tryFirst}>
          <h2><a href={i.href}>{i.title}</a></h2>
          <p class="desc">{i.description}</p>
          <dl class="facts meta">
            <dt>{t.problem}</dt><dd>{i.problem}</dd>
            <dt>{t.context}</dt><dd>{i.context}</dd>
          </dl>
          <p class="score meta" hidden></p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .head { margin-block-end: var(--s-l); }
  .kicker {
    display: flex; align-items: baseline; gap: var(--s-2xs);
    font-family: var(--f-sans); font-size: var(--t-xs);
    text-transform: uppercase; letter-spacing: .08em; color: var(--c-muted);
  }
  .kicker .count { color: var(--c-mark); font-variant-numeric: tabular-nums; }
  .kicker a { text-decoration: none; }
  h1 {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-3xl);
    line-height: var(--lh-tight); letter-spacing: -0.02em;
  }
  .blurb {
    margin-block-start: var(--s-2xs); max-inline-size: 38ch;
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-size: var(--t-lg); line-height: 1.25; color: var(--c-muted);
  }

  .picker { border: 0; padding: 0; margin: 0; }
  .picker legend { padding: 0; margin-block-end: var(--s-2xs); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--s-3xs); }
  .chip {
    display: inline-flex; align-items: center; gap: .45em;
    padding: .35em .8em;
    border: 1px solid var(--c-border); border-radius: 999px;
    background: var(--c-surface);
    font-family: var(--f-sans); font-size: var(--t-xs);
    cursor: pointer; user-select: none;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .chip:hover { border-color: var(--c-accent); }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip:has(input:checked) {
    background: color-mix(in srgb, var(--c-accent) 12%, var(--c-surface));
    border-color: var(--c-accent);
  }
  .chip:has(input:focus-visible) { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .chip small { color: var(--c-muted); font-variant-numeric: tabular-nums; }

  #clear {
    margin-block-start: var(--s-2xs);
    background: none; border: 0; padding: 0;
    font-family: var(--f-sans); font-size: var(--t-xs);
    color: var(--c-accent); cursor: pointer; text-decoration: underline;
  }
  .status { margin-block: var(--s-m) var(--s-s); }

  .results { list-style: none; padding: 0; display: grid; gap: var(--s-m); max-inline-size: 66ch; }
  .results li { padding-block-start: var(--s-s); border-block-start: 1px solid var(--c-border); }
  .results li[hidden] { display: none; }
  .results h2 {
    font-family: var(--f-serif); font-variation-settings: var(--axis-display);
    font-weight: 400; font-size: var(--t-md); line-height: var(--lh-snug);
  }
  .results h2 a { text-decoration: none; }
  .results h2 a:hover { color: var(--c-accent); }
  .desc {
    margin-block-start: var(--s-3xs);
    font-family: var(--f-sans); font-size: var(--t-sm); line-height: 1.5; color: var(--c-muted);
  }
  .facts {
    margin-block-start: var(--s-2xs);
    display: grid; grid-template-columns: auto 1fr; gap: 2px var(--s-2xs);
  }
  .facts dt { text-transform: uppercase; letter-spacing: .06em; }
  .score { margin-block-start: var(--s-3xs); color: var(--c-accent); }
</style>

<script>
  const results = document.getElementById('results')!;
  const status = document.getElementById('status')!;
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.chip input'));
  const rows = Array.from(results.querySelectorAll<HTMLLIElement>('li'));

  const symptomsOf = (row: HTMLLIElement): string[] =>
    JSON.parse(row.dataset.symptoms || '[]');

  function apply() {
    const picked = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
    const anyPicked = picked.size > 0;

    const scored = rows.map((row) => ({
      row,
      hits: symptomsOf(row).filter((s) => picked.has(s)).length,
      tryFirst: Number(row.dataset.try || 50),
    }));

    const visible = anyPicked ? scored.filter((s) => s.hits > 0) : scored;
    visible.sort((a, b) => b.hits - a.hits || a.tryFirst - b.tryFirst);

    const shown = new Set(visible.map((v) => v.row));
    for (const { row } of scored) row.hidden = !shown.has(row);

    // Sıralamayı DOM'a yansıt — eşleşen playbook başa çıksın.
    for (const { row, hits } of visible) {
      results.appendChild(row);
      const badge = row.querySelector<HTMLElement>('.score')!;
      badge.hidden = !anyPicked;
      badge.textContent = anyPicked ? hits + ' ' + status.dataset.match : '';
    }

    status.textContent = !anyPicked
      ? status.dataset.none!
      : visible.length === 0
        ? status.dataset.nomatch!
        : visible.length + ' / ' + rows.length;
  }

  boxes.forEach((b) => b.addEventListener('change', apply));
  document.getElementById('clear')?.addEventListener('click', () => {
    boxes.forEach((b) => (b.checked = false));
    apply();
  });
  apply();
</script>
