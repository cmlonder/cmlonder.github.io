---
import ListPage from '../../../layouts/ListPage.astro';
import { TOPICS, TOPIC_LABELS, type Locale, PAGE } from '../../../config';
import { getEntriesByTopic, localePath } from '../../../lib/content';

export async function getStaticPaths() {
  // Boş konu sayfası üretme — ince içerikli sayfa SEO'ya zarar verir.
  const withEntries = await Promise.all(
    TOPICS.map(async (topic) => ({
      topic,
      count: (await getEntriesByTopic(topic, 'tr')).length,
    }))
  );
  return withEntries.filter((t) => t.count > 0).map(({ topic }) => ({ params: { topic } }));
}

const lang: Locale = 'tr';
const other = 'en' as const;
const { topic } = Astro.params as { topic: typeof TOPICS[number] };

const items = await getEntriesByTopic(topic, lang);
const otherItems = await getEntriesByTopic(topic, other);
const altLocale = otherItems.length
  ? { lang: other, href: localePath(other, 'topics', topic) }
  : null;

const blurb = PAGE[lang].topicBlurb(TOPIC_LABELS[topic][lang]);
---

<ListPage
  title={TOPIC_LABELS[topic][lang]}
  blurb={blurb}
  lang={lang}
  items={items}
  altLocale={altLocale}
  showCollection
/>
