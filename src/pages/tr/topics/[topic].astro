---
import TopicPage from '../../../layouts/TopicPage.astro';
import { topicLabel, PAGE, type Locale } from '../../../config';
import { getAllTopics, getEntriesByTopic, getShelfTopicEntries, localePath } from '../../../lib/content';

export async function getStaticPaths() {
  const topics = await getAllTopics('tr');
  return topics.map(({ slug }) => ({ params: { topic: slug } }));
}

const lang: Locale = 'tr';
const { topic } = Astro.params as { topic: string };

const items = await getEntriesByTopic(topic, lang);
const shelves = await getShelfTopicEntries(topic, lang);
const otherItems = await getEntriesByTopic(topic, 'en');
const altLocale = otherItems.length
  ? { lang: 'en' as const, href: localePath('en', 'topics', topic) }
  : null;

const ad = (await getAllTopics(lang)).find((t) => t.slug === topic)?.topic ?? topic;
---

<TopicPage title={topicLabel(ad, lang)} blurb={PAGE[lang].topicBlurb(topicLabel(ad, lang))}
           lang={lang} items={items} shelves={shelves} altLocale={altLocale} />
