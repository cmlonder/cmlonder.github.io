---
// GEÇİCİ doğrulama sayfası — Faz 3'te tasarımla değiştirilecek.
import { getAllEntries, getTranslations, formatDate, entryPath } from '../lib/content';
import { COLLECTION_LABELS, SITE } from '../config';

const byLocale = await Promise.all(
  SITE.locales.map(async (lang) => ({ lang, items: await getAllEntries(lang) }))
);

const withTranslations = await Promise.all(
  byLocale.map(async ({ lang, items }) => ({
    lang,
    items: await Promise.all(
      items.map(async ({ collection, entry }) => ({
        collection,
        entry,
        translations: await getTranslations(collection, entry.id.split('/').slice(1).join('/')),
      }))
    ),
  }))
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>cmlonder.com — content layer check</title>
  </head>
  <body style="font-family: ui-monospace, monospace; max-width: 60rem; margin: 3rem auto; padding: 0 1rem; line-height: 1.6">
    <h1>İçerik katmanı doğrulaması</h1>
    <p>Bu sayfa geçici. Faz 3'te gerçek tasarımla değişecek.</p>

    {withTranslations.map(({ lang, items }) => (
      <section>
        <h2>[{lang}] — {items.length} girdi</h2>
        <ul>
          {items.map(({ collection, entry, translations }) => {
            const slug = entry.id.split('/').slice(1).join('/');
            return (
              <li>
                <strong>{COLLECTION_LABELS[collection][lang]}</strong>
                {' · '}
                <a href={entryPath(lang, collection, slug)}>{entry.data.title}</a>
                {' · '}
                <small>
                  {formatDate(entry.data.pubDate, lang)}
                  {' · topics: '}{entry.data.topics.join(', ')}
                  {' · diller: '}{translations.join('/')}
                </small>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </body>
</html>
