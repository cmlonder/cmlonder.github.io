---
import { getCollection } from 'astro:content';
import ShelfEntry from '../../layouts/ShelfEntry.astro';
import { type Locale } from '../../config';

export async function getStaticPaths() {
  const all = await getCollection('library');
  const kendi = all.filter((e) => e.id.startsWith('en/'));
  const liste = (kendi.length ? kendi : all.filter((e) => e.id.startsWith('en/')))
    .sort((a, b) => a.data.order - b.data.order);

  return liste.map((entry, i) => ({
    params: { slug: entry.id.split('/').pop()! },
    props: { entry, prev: liste[i - 1] ?? null, next: liste[i + 1] ?? null },
  }));
}

const lang: Locale = 'en';
const { entry, prev, next } = Astro.props;
---

<ShelfEntry entry={entry} shelf="library" lang={lang} prev={prev} next={next} />
